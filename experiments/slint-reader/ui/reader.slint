 // One pure binding evaluates all geometry against the exact progress of this frame.
 pure callback compute-fold(float, float, float, bool, int, bool) -> FoldGeometry;
 private property <FoldGeometry> fold: root.compute-fold(root.turn-progress, root.image-w, root.image-h, root.turn-single, root.turn-direction, root.turn-top);
 out property <float> fold-plane-x: root.fold.plane_x; out property <float> fold-plane-y: root.fold.plane_y; out property <float> fold-plane-angle: root.fold.plane_angle;
