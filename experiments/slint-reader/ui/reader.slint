        Rectangle { layout-order: 0; horizontal-stretch: 1; Rectangle { y: parent.height / 2; height: 1px; background: UiColors.edge; } }
        Text { layout-order: 1; text: root.arabic ? "التصفح والانتقال" : "Browse and jump"; color: UiColors.muted; font-size: 12px; vertical-alignment: center; }
