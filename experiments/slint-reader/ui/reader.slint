 keys := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.clicked(); return accept; } return reject; } }
 touch := TouchArea { clicked => { keys.focus(); root.clicked(); } }
}
component SearchResult inherits Rectangle {
 in property <SearchEntry> entry; in property <bool> rtl; in property <bool> enabled: true; in property <bool> selected: false;
 callback clicked();
 height: root.entry.detail == "" ? 56px : root.entry.secondary != "" ? 68px : 93px;
 vertical-stretch: 0;
 border-radius: 8px; background: root.selected ? UiColors.field : touch.has-hover || (keys.has-focus && UiColors.keyboard-focus) ? UiColors.field.with-alpha(0.6) : transparent;
 border-width: root.selected ? 1px : 0px; border-color: UiColors.edge;
 accessible-role: button; accessible-label: root.entry.badge + " " + root.entry.title + " " + root.entry.secondary; accessible-description: root.entry.detail; accessible-enabled: enabled;
