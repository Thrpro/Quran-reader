      Text { x: 23px; y: 0px; width: parent.width - 26px; height: parent.height; text: root.arabic ? "قارئ المصحف" : "Quran Mushaf Reader"; color: UiColors.ink; font-size: 12px; vertical-alignment: center; horizontal-alignment: root.arabic ? right : left; overflow: elide; }
