        if self.mouse-x / 1px < root.image-x + 28 || self.mouse-x / 1px > root.image-x + root.image-w - 28 || self.mouse-y / 1px < root.image-y + 24 || self.mouse-y / 1px > root.image-y + root.image-h - 24 {
