        ChoiceField { rtl: root.arabic; label: root.arabic ? "لغة التطبيق" : "Application language"; model: ["العربية", "English"]; current-index: root.arabic ? 0 : 1; selected(i) => { root.arabic = i == 0; reader-keys.focus(); } }
        Text { text: root.arabic ? "المظهر" : "Appearance"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
        ChoiceField { rtl: root.arabic; label: root.arabic ? "مظهر التطبيق" : "Application theme"; model: root.arabic ? ["رمادي داكن", "فاتح", "ورقي", "أسود", "كحلي"] : ["Dark gray", "Light", "Sepia", "Pure black", "Navy night"]; current-index <=> root.theme; selected(i) => { root.theme = i; reader-keys.focus(); } }
        }
        SectionHeading {text: root.arabic ? "القراءة" : "Reading"; horizontal-alignment: root.arabic ? right : left;}
        SettingsGroup {
        ToggleRow { text: root.arabic ? "إطالة الحروف السياقية" : "Contextual letter elongation"; hint: root.arabic ? "استخدام الرسم الأصلي ذي الامتداد السياقي" : "Use the original contextual rendering mode"; rtl: root.arabic; checked <=> root.contextual; toggled => { root.preferences-changed(); } }
        ToggleRow { text: root.arabic ? "عرض صفحة واحدة" : "One page at a time"; rtl: root.arabic; checked <=> root.single-page; toggled => { root.preferences-changed(); } }
        ToggleRow { text: root.arabic ? "إظهار ساعة الصفحة" : "Show page clock"; rtl: root.arabic; checked <=> root.show-clock; toggled => { root.preferences-changed(); } }
        if root.show-clock : ToggleRow { text: root.arabic ? "الساعة بنظام 24 ساعة" : "24-hour clock"; rtl: root.arabic; checked <=> root.clock-24; toggled => { root.preferences-changed(); } }
        ToggleRow { text: root.arabic ? "حركة القوائم والانتقالات" : "Panel and transition motion"; rtl: root.arabic; checked <=> root.motion-enabled; toggled => { root.preferences-changed(); } }
        ToggleRow { text: root.arabic ? "استخدام الرسم البرمجي" : "Use software rendering"; hint: root.arabic ? "يسري بعد إعادة تشغيل التطبيق. جرّبه إذا ظهرت مشكلات في الرسم أو ارتفع استخدام المعالج" : "Takes effect after restarting. Try this if you see drawing problems or high CPU use"; rtl: root.arabic; checked <=> root.software-rendering; toggled => { root.preferences-changed(); } }
        ToggleRow { text: root.arabic ? "فتح التفسير بالنقر الأيسر" : "Open tafsir with a left click"; hint: root.arabic ? "يمكن فتح التفسير دائمًا من قائمة الزر الأيمن للآية" : "Tafsir is always available from an ayah’s right-click menu"; rtl: root.arabic; checked <=> root.open-tafsir-on-click; toggled => { root.preferences-changed(); } }
        }
        SettingsLink {text: root.arabic ? "اختصارات لوحة المفاتيح" : "Keyboard shortcuts"; detail: root.shortcuts-open ? "−" : "+"; rtl: root.arabic; clicked => {root.shortcuts-open = !root.shortcuts-open;} }
        if root.shortcuts-open : SettingsGroup {
        ChoiceField { rtl: root.arabic; label: root.arabic ? "اختصار البحث" : "Search shortcut"; model: root.arabic ? ["البحث · ⁦Ctrl+F⁩", "البحث · ⁦Ctrl+K⁩", "البحث · ⁦Ctrl+/⁩"] : ["Search · ⁦Ctrl+F⁩", "Search · ⁦Ctrl+K⁩", "Search · ⁦Ctrl+/⁩"]; current-index <=> root.search-shortcut; selected(i) => { root.preferences-changed(); } }
        ChoiceField { rtl: root.arabic; label: root.arabic ? "اختصار الاستماع" : "Listening shortcut"; model: root.arabic ? ["الاستماع · ⁦Ctrl+L⁩", "الاستماع · ⁦Ctrl+P⁩"] : ["Listen · ⁦Ctrl+L⁩", "Listen · ⁦Ctrl+P⁩"]; current-index <=> root.listen-shortcut; selected(i) => { root.preferences-changed(); } }
        ChoiceField { rtl: root.arabic; label: root.arabic ? "اختصار الخيارات" : "Options shortcut"; model: root.arabic ? ["الخيارات · ⁦Ctrl+,⁩", "الخيارات · ⁦Ctrl+O⁩"] : ["Options · ⁦Ctrl+,⁩", "Options · ⁦Ctrl+O⁩"]; current-index <=> root.options-shortcut; selected(i) => { root.preferences-changed(); } }
        Text { text: root.arabic ? "F11: ملء الشاشة · Ctrl+Space: إيقاف التلاوة مؤقتًا أو متابعتها" : "F11: full screen · Ctrl+Space: pause or resume recitation"; color: UiColors.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: root.arabic ? right : left; }
        }
        Rectangle {height: 1px; background: UiColors.edge.with-alpha(0.5);}
        SettingsLink {text: root.fullscreen ? (root.arabic ? "إنهاء ملء الشاشة" : "Exit full screen") : (root.arabic ? "ملء الشاشة" : "Full screen"); detail: "F11"; rtl: root.arabic; clicked => {root.dismiss-overlays();root.fullscreen-requested();} }
        SettingsLink {text: root.arabic ? "العلامات المحفوظة" : "Saved bookmarks"; rtl: root.arabic; clicked => {root.panel = "bookmarks";} }
        SettingsLink {text: root.arabic ? "عرض المقدمة" : "Show introduction"; rtl: root.arabic; clicked => {root.onboarding-complete = false;root.panel = "";root.preferences-changed();} }
        SettingsLink {text: root.arabic ? "حول التطبيق" : "About the app"; rtl: root.arabic; clicked => {root.about-requested();} }
        if root.session-only : Text {text: root.arabic ? "تُطبّق التغييرات لهذه الجلسة فقط؛ تعذّر حفظ الإعدادات." : "Changes apply to this session only; settings could not be saved."; color: UiColors.muted; font-size: 11px; wrap: word-wrap; horizontal-alignment: root.arabic ? right : left;}
        Rectangle {preferred-height: 0px; vertical-stretch: 1; background: transparent;}
       }
      }
      if root.panel-kind == "study" : VerticalLayout {
       spacing: 8px;
       ChoiceField { init => { root.study-choice-height = self.height / 1px; } changed height => { root.study-choice-height = self.height / 1px; } rtl: root.arabic; label: root.arabic ? "مصدر التفسير" : "Tafsir source"; model: root.arabic ? ["المختصر في التفسير", "تفسير السعدي"] : ["Saheeh International · translation"]; current-index: root.arabic ? min(root.study-source, 1) : 0; selected(i) => { root.study-source = root.arabic ? i : 2; root.study-source-changed(root.study-source); reader-keys.focus(); } }
       HorizontalLayout { height: 30px; spacing: 8px;
        Action { layout-order: root.arabic ? 2 : 0; width: 32px; text: "‹"; hint: root.arabic ? "الآية السابقة" : "Previous ayah"; clicked => { root.study-step(-1); reader-keys.focus(); } }
        Text { layout-order: 1; text: root.study-title; color: UiColors.accent; font-size: 13px; font-weight: 600; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; overflow: elide; Tooltip { Text { text: root.study-title; color: UiColors.ink; max-width: 320px; wrap: word-wrap; } } }
        Action { layout-order: root.arabic ? 0 : 2; width: 32px; text: "›"; hint: root.arabic ? "الآية التالية" : "Next ayah"; clicked => { root.study-step(1); reader-keys.focus(); } }
       }
       HorizontalLayout { height: 24px;
        QuietLink { width: 104px; text: root.arabic ? "حجم النص" : "Text size"; clicked => { root.size-tools = !root.size-tools; } }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if root.audio-active : QuietLink { width: 154px; text: root.follow-recitation ? (root.arabic ? "متابعة التلاوة: مفعّلة" : "Following recitation") : (root.arabic ? "متابعة التلاوة" : "Follow recitation"); hint: root.arabic ? "إظهار تفسير الآية التي تُتلى تلقائيًا" : "Automatically show the study text for the verse being recited"; clicked => { root.follow-recitation = !root.follow-recitation; root.preferences-changed(); } }
       }
       if root.size-tools : HorizontalLayout { height: 32px; spacing: 8px;
        Action { width: 36px; text: "A−"; hint: root.arabic ? "تصغير نص التفسير" : "Smaller study text"; clicked => { root.study-size = max(14, root.study-size - 1); root.preferences-changed(); } }
        Text { text: round(root.study-size); color: UiColors.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
        Action { width: 36px; text: "A+"; hint: root.arabic ? "تكبير نص التفسير" : "Larger study text"; clicked => { root.study-size = min(26, root.study-size + 1); root.preferences-changed(); } }
       }
       Rectangle { height: 1px; background: UiColors.edge; }
       body := ReadingBody { body: root.study-body; text-size: root.study-size; rtl: root.arabic; vertical-stretch: 1; }
       Rectangle { height: 16px; background: transparent; Text { width: parent.width; height: parent.height; text: root.arabic ? "مرّر لقراءة بقية التفسير" : "Scroll to continue reading"; opacity: body.overflowing ? 1 : 0; color: UiColors.muted; font-size: 11px; horizontal-alignment: root.arabic ? right : left; } }
       Text { text: root.arabic ? "المصدر: المكتبة القرآنية الشاملة" : "Source: Quranic Universal Library"; color: UiColors.muted; font-size: 10px; horizontal-alignment: root.arabic ? right : left; }
       if root.audio-active : Rectangle { height: 1px; background: UiColors.edge; }
       if root.audio-active : HorizontalLayout { height: 24px;
        Text { text: root.audio-title; color: UiColors.muted; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: root.arabic ? right : left; overflow: elide; }
        Action { width: 34px; quiet: true; symbol: 5; text: root.arabic ? "إعدادات الاستماع" : "Listening settings"; hint: root.arabic ? "إعدادات الاستماع" : "Listening settings"; clicked => { root.panel = "listen"; } }
       }
       if root.audio-active : Transport { height: 124px; rtl: root.arabic; paused: root.audio-paused; terminal: root.audio-terminal; can-seek: root.audio-can-seek; loading: root.audio-loading; clock: root.audio-clock; status: root.audio-status; progress: root.audio-progress; toggle => { root.audio-toggle(); } end => { root.audio-end(); } skip(s) => { root.audio-skip(s); } seek(v) => { root.audio-seek(v); } show-ayah => { root.show-recited-ayah(); } }

      }
      if root.panel-kind == "bookmarks" : ScrollView { horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: as-needed;
       VerticalLayout { spacing: 8px;
        for mark[index] in root.bookmarks : Rectangle { height: 66px; border-radius: 8px; background: UiColors.field;
         HorizontalLayout { padding: 8px; spacing: 8px;
          VerticalLayout { layout-order: root.arabic ? 1 : 0; horizontal-stretch: 1; spacing: 3px;
           Action { text: mark.title; rtl: root.arabic; centered: false; quiet: true; clicked => { root.choose-bookmark(index); root.panel = ""; reader-keys.focus(); } }
           Text { text: mark.detail; color: UiColors.muted; font-size: 11px; horizontal-alignment: root.arabic ? right : left; overflow: elide; }
          }
          Action { layout-order: root.arabic ? 0 : 1; width: 64px; text: root.arabic ? "إزالة" : "Remove"; clicked => { root.remove-bookmark(index); } }
         }
        }
        if root.bookmarks.length == 0 : Text { text: root.arabic ? "لم تحفظ علامات بعد. اضغط بزر الفأرة الأيمن على آية لحفظها." : "No saved bookmarks yet. Right-click a verse to save one."; color: UiColors.muted; font-size: 13px; wrap: word-wrap; horizontal-alignment: root.arabic ? right : left; }
        Rectangle { vertical-stretch: 1; background: transparent; }
       }
      }
      if root.panel-kind == "listen" : VerticalLayout { spacing: 9px;
       ScrollView { horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: as-needed; vertical-stretch: 1;
        VerticalLayout { spacing: 9px;
         Text { height: 18px; text: root.arabic ? "القارئ" : "Reciter"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         ChoiceField { rtl: root.arabic; label: root.arabic ? "اختيار القارئ" : "Choose reciter"; model: root.reciters; current-index <=> root.reciter-index; enabled: root.reciters.length > 0; selected(i) => { root.reciter-changed(i); reader-keys.focus(); } }
         ToggleRow { text: root.arabic ? "هذه الآية فقط" : "This ayah only"; hint: root.arabic ? "عند إيقاف الخيار تستمر التلاوة إلى نهاية السورة" : "When off, continue to the end of the surah"; rtl: root.arabic; checked <=> root.listen-only-ayah; toggled => { root.preferences-changed(); } }
         Action { height: 36px; text: root.arabic ? "بدء التلاوة" : "Start recitation"; primary: true; enabled: root.reciters.length > 0; clicked => { root.play-selected(); } }
         Rectangle { height: 1px; background: UiColors.edge; }
         Text { height: 18px; text: root.arabic ? "سرعة التلاوة" : "Playback speed"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         ChoiceField { rtl: root.arabic; label: root.arabic ? "سرعة التلاوة" : "Playback speed"; model: ["0.75×", "1×", "1.25×", "1.5×", "1.75×", "2×"]; current-index: root.playback-rate < 0.9 ? 0 : root.playback-rate < 1.1 ? 1 : root.playback-rate < 1.4 ? 2 : root.playback-rate < 1.6 ? 3 : root.playback-rate < 1.9 ? 4 : 5; selected(i) => { root.playback-rate = i == 0 ? 0.75 : i == 1 ? 1 : i == 2 ? 1.25 : i == 3 ? 1.5 : i == 4 ? 1.75 : 2; root.audio-rate(root.playback-rate); reader-keys.focus(); } }
         ToggleRow { text: root.arabic ? "تذكّر سرعة التلاوة" : "Remember playback speed"; hint: root.arabic ? "عند إيقاف الخيار تبدأ التلاوة الجديدة بسرعة 1×" : "When off, new recitations start at 1×"; rtl: root.arabic; checked <=> root.remember-speed; toggled => { root.preferences-changed(); } }
         Text { height: 18px; text: (root.arabic ? "مستوى الصوت · " : "Volume · ") + round(root.volume) + "%"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         SeekTrack { value: root.volume / 100; rtl: root.arabic; label: root.arabic ? "مستوى الصوت" : "Volume"; seek(v) => { root.volume = v * 100; root.audio-volume(root.volume); } }
         HorizontalLayout { height: 16px; Text { text: root.arabic ? "100%" : "0%"; color: UiColors.muted; font-size: 10px; horizontal-stretch: 1; } Text { text: root.arabic ? "0%" : "100%"; color: UiColors.muted; font-size: 10px; horizontal-stretch: 1; horizontal-alignment: right; } }
         Rectangle { preferred-height: 0px; vertical-stretch: 1; background: transparent; }
        }
       }
       if root.audio-active : Rectangle { height: 1px; background: UiColors.edge; }
       if root.audio-active : Transport { rtl: root.arabic; paused: root.audio-paused; terminal: root.audio-terminal; can-seek: root.audio-can-seek; loading: root.audio-loading; clock: root.audio-clock; status: root.audio-status; progress: root.audio-progress; toggle => { root.audio-toggle(); } end => { root.audio-end(); } skip(s) => { root.audio-skip(s); } seek(v) => { root.audio-seek(v); } show-ayah => { root.show-recited-ayah(); } }
      }
     }
    }    // Open panels dock playback into the toolbar, never over study text.
    if root.audio-active && root.player-expanded && !root.player-docked && root.panel == "" : Rectangle {
     width: min(264px, max(188px, (canvas.width - root.image-w * 1px) / 2 - 16px)); height: root.audio-status == "" ? 186px : 202px;
     x: root.arabic ? canvas.width - self.width - 10px : 10px; y: canvas.height - self.height - 10px;
     border-radius: 12px; border-width: 1px; border-color: UiColors.edge; background: UiColors.surface;
     VerticalLayout { padding: 11px; spacing: 7px;
      HorizontalLayout { height: 26px; spacing: 6px;
       Text { text: root.audio-title; color: UiColors.ink; font-size: 13px; font-weight: 600; horizontal-stretch: 1; horizontal-alignment: root.arabic ? right : left; vertical-alignment: center; overflow: elide; Tooltip { Text { text: root.audio-title; color: UiColors.ink; max-width: 320px; wrap: word-wrap; } } }
       Action { width: 34px; symbol: 5; text: root.arabic ? "إعدادات الاستماع" : "Listening settings"; hint: root.arabic ? "إعدادات الاستماع" : "Listening settings"; clicked => { root.panel = "listen"; } }
       Action { width: 28px; symbol: 2; text: root.arabic ? "تصغير المشغّل" : "Minimize player"; hint: root.arabic ? "تصغير المشغّل إلى شريط العنوان" : "Minimize player to the title bar"; clicked => { root.player-expanded = false; } }
      }
      Transport { rtl: root.arabic; paused: root.audio-paused; terminal: root.audio-terminal; can-seek: root.audio-can-seek; loading: root.audio-loading; clock: root.audio-clock; status: root.audio-status; progress: root.audio-progress; toggle => { root.audio-toggle(); } end => { root.audio-end(); } skip(s) => { root.audio-skip(s); } seek(v) => { root.audio-seek(v); } show-ayah => { root.show-recited-ayah(); } }
     }
    }
    if root.fullscreen && root.panel == "" : Action { x: root.arabic ? canvas.width - self.width - 8px : 8px; y: 5px; width: 128px; height: 30px; quiet: true; text: root.arabic ? "إنهاء ملء الشاشة" : "Exit full screen"; hint: root.arabic ? "إنهاء ملء الشاشة (Escape)" : "Exit full screen (Escape)"; clicked => { root.fullscreen-requested(); } }
    if root.fullscreen && root.panel == "" : VerticalLayout { x: root.arabic ? canvas.width - self.width - 4px : 4px; y: 42px; width: 44px; height: root.audio-active && root.player-docked ? 200px : 120px; spacing: 4px;
     Action { height: 36px; symbol: 8; quiet: true; selected: root.panel == "search"; text: root.arabic ? "بحث" : "Search"; hint: root.arabic ? "بحث" : "Search"; clicked => { if root.panel == "search" { root.panel = ""; } else { root.panel = "search"; root.search(root.search-query); } } }
     Action { height: 36px; symbol: 9; quiet: true; selected: root.panel == "listen"; text: root.arabic ? "استماع" : "Listen"; hint: root.arabic ? "الاستماع والتلاوة" : "Listening and recitation"; clicked => { root.panel = root.panel == "listen" ? "" : "listen"; } }
     Action { height: 36px; symbol: 10; quiet: true; selected: root.panel == "settings"; text: root.arabic ? "الخيارات" : "Options"; hint: root.arabic ? "الخيارات" : "Options"; clicked => { root.panel = root.panel == "settings" ? "" : "settings"; } }
     if root.audio-active && root.player-docked : Action { height: 36px; symbol: root.audio-paused || root.audio-terminal ? 7 : 6; selected: true; enabled: !root.audio-loading; text: root.audio-terminal ? (root.arabic ? "تشغيل مجددًا" : "Play again") : root.audio-paused ? (root.arabic ? "متابعة التلاوة" : "Resume recitation") : (root.arabic ? "إيقاف مؤقت" : "Pause recitation"); clicked => { root.audio-toggle(); } }
     if root.audio-active && root.player-docked : Action { height: 36px; text: root.arabic ? "إنهاء" : "End"; hint: root.arabic ? "إنهاء التلاوة وإغلاق المشغّل" : "End recitation and close the player"; clicked => { root.audio-end(); } }
    }
    if root.context-open : TouchArea { clicked => { root.context-open = false; reader-keys.focus(); } }
    if root.context-open : Rectangle {
     width: 270px; height: 178px;
     x: ((root.context-x + root.canvas-x) * 1px).clamp(10px, max(10px, canvas.width - self.width - 10px)); y: (root.context-y * 1px).clamp(10px, max(10px, canvas.height - self.height - 10px));
     border-radius: 8px; border-width: 1px; border-color: UiColors.edge; background: UiColors.surface;
     VerticalLayout { padding: 8px; spacing: 3px;
      Text { height: 20px; text: root.context-title; color: UiColors.muted; font-size: 11px; horizontal-alignment: root.arabic ? right : left; vertical-alignment: center; overflow: elide; }
      Rectangle { height: 1px; background: UiColors.edge.with-alpha(0.6); }
      MenuAction { icon: 0; text: root.arabic ? "قراءة التفسير" : "Read Tafsir"; rtl: root.arabic; clicked => { root.context-open = false; root.study-selected(); } }
      MenuAction { icon: 1; text: root.arabic ? "الاستماع من هنا" : "Listen from here"; rtl: root.arabic; clicked => { root.context-open = false; root.listen-selected(); } }
      MenuAction { icon: 2; text: root.bookmark-present ? (root.arabic ? "إزالة العلامة" : "Remove bookmark") : (root.arabic ? "حفظ علامة" : "Save bookmark"); rtl: root.arabic; clicked => { root.context-open = false; root.bookmark-selected(); } }
     }
    }
    if root.notice != "" || root.notification != "" : Rectangle {
     width: min(380px, canvas.width - 30px); height: 38px; x: (canvas.width - self.width) / 2; y: canvas.height - self.height - 12px;
     border-radius: 8px; border-width: 1px; border-color: UiColors.edge; background: UiColors.surface;
     Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.notice != "" ? root.notice : root.notification; color: UiColors.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
   }

  }
 }
 if !root.onboarding-complete : FocusScope {
  x: 0px; y: root.canvas-y * 1px; width: root.width; height: root.height - self.y;
  init => { self.focus(); }
  forward-focus: welcome-arabic;
  Rectangle {
  background: UiColors.canvas.with-alpha(0.94);
  TouchArea { }
  Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: min(500px, parent.width - 40px); height: 270px; border-radius: 14px; border-width: 1px; border-color: UiColors.edge; background: UiColors.surface;
   VerticalLayout { padding: 24px; spacing: 15px;
    Text { height: 35px; text: "قارئ المصحف  ·  Quran Mushaf Reader"; color: UiColors.ink; font-size: 19px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    Text { height: 50px; text: "اختر لغة التطبيق  ·  Choose your language"; color: UiColors.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
    HorizontalLayout { height: 42px; spacing: 10px;
     welcome-arabic := Action { text: "العربية"; horizontal-stretch: 1; clicked => { root.arabic = true; root.onboarding-complete = true; root.preferences-changed(); reader-keys.focus(); } }
     Action { text: "English"; horizontal-stretch: 1; clicked => { root.arabic = false; root.onboarding-complete = true; root.preferences-changed(); reader-keys.focus(); } }
    }
    Text { height: 35px; text: "يمكن تغيير اللغة لاحقًا من الخيارات  ·  Change it later in Options"; color: UiColors.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
   }
  }
 }
 }
 Rectangle { width: 4px; height: root.height; TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-edge(0); } } } }
 Rectangle { x: root.width - 4px; width: 4px; height: root.height; TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-edge(1); } } } }
 Rectangle { width: root.width; height: 4px; TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-edge(2); } } } }
 Rectangle { y: root.height - 4px; width: root.width; height: 4px; TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-edge(3); } } } }
}

export component ReaderAbout inherits Window {
 title: "About the Slint reading prototype"; width: 440px; height: 310px; default-font-family: "Segoe UI"; background: Palette.background;
 VerticalLayout { padding: 24px; spacing: 16px;
  Text { text: "Quran Mushaf Reader · Preview"; color: Palette.foreground; font-size: 20px; font-weight: 600; }
  Text { text: "An independent Slint preview using the original native Quran renderer and verified local resources. Your normal reader and profile remain preserved."; color: Palette.foreground; wrap: word-wrap; }
  AboutSlint {}
  Action { text: "Close"; clicked => { root.hide(); } }
 }
}



