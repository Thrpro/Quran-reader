         accepted => {if root.search-active-index >= 0 && !root.search-busy {if root.choose-result(root.search-active-index) {root.panel = "";reader-keys.focus();}} else if root.jump-page(self.text) {root.panel = "";reader-keys.focus();} else if root.results.length > 0 && !root.search-busy && root.search-query != "" {if root.choose-result(0) {root.panel = "";reader-keys.focus();}} }
         key-pressed(event) => {
