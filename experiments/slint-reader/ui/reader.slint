     y: (root.image-y + (root.book-w > 0 ? root.book-y : 0)) * 1px;
     width: (root.book-w > 0 ? root.book-w : root.image-w) * 1px;
     height: (root.book-w > 0 ? root.book-h : root.image-h) * 1px;
     Rectangle {
      x: -(root.book-w > 0 ? root.book-x : 0) * 1px; y: -(root.book-w > 0 ? root.book-y : 0) * 1px;
      width: root.image-w * 1px; height: root.image-h * 1px;
      Image {
       x: 0px; y: 0px; width: root.image-w * 1px; height: root.image-h * 1px;
