 // Slint drives the retained textures on its monitor-aware animation clock.
 // No worker raster, UI upload or application timer is needed for each frame.
 out property <float> turn-progress: root.turn-priming ? 0 : root.drag-active ? root.drag-progress : root.drag-canceling ? 0 : root.turn-running ? 1 : 0;
 animate turn-progress { duration: root.drag-active ? 0ms : root.drag-canceling ? 180ms : root.turn-running ? root.turn-duration : 0ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
