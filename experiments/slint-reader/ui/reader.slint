 callback download-start(int); callback download-cancel(); callback download-delete(int); callback downloads-refresh();
 callback audio-toggle(); callback audio-end(); callback audio-seek(float); callback audio-skip(int); callback audio-rate(float); callback audio-volume(float); callback show-recited-ayah();
 // Find your place: browse by surah (0), page (1) or juz, hizb and rub (2).
