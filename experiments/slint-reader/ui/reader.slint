         for tab[i] in (root.arabic ? ["الكل", "السور", "الصفحات", "الأجزاء", "الأحزاب", "الأرباع"] : ["All", "Surahs", "Pages", "Juz", "Hizb", "Quarters"]) : SearchTab {
