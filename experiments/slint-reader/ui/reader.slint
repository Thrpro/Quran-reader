// Authentic Quran pixels and hit maps are supplied by the unchanged native renderer.
import { AboutSlint, LineEdit, Palette, ScrollView } from "std-widgets.slint";
export struct SearchEntry { title: string, detail: string, badge: string, secondary: string }
export struct BookmarkEntry { title: string, detail: string }
export struct FoldGeometry { plane_x: float, plane_y: float, plane_angle: float, back_x: float, back_y: float, back_angle: float }
export struct HoverRect { x: float, y: float, w: float, h: float }
export struct HoverPatch { x: float, y: float, w: float, h: float, image: image }
global UiColors {
 in-out property <bool> keyboard-focus: false;
 // 0 dark gray, 1 light, 2 sepia, 3 pure black, 4 navy night.
 in-out property <int> theme: 0;
 in-out property <int> old-theme: 0;
 in-out property <float> phase: 1;
 pure function dark-theme(t: int) -> bool { return t == 0 || t == 3 || t == 4; }
 pure function pick(t: int, gray: color, light: color, sepia: color, black: color, navy: color) -> color {
  return t == 1 ? light : t == 2 ? sepia : t == 3 ? black : t == 4 ? navy : gray;
 }
 pure function level(t: int) -> float { return t == 1 ? 252 : t == 2 ? 239 : t == 3 ? 8 : t == 4 ? 22 : 37; }
 out property <bool> polarity-change: phase > 0 && phase < 1 && (dark-theme(theme) != dark-theme(old-theme));
 out property <float> surface-level: level(theme) * phase + level(old-theme) * (1 - phase);
 out property <color> readable-ink: surface-level >= 118 ? #000000 : #ffffff;
 out property <float> accent-level: (dark-theme(theme) ? 188 : 95) * phase + (dark-theme(old-theme) ? 188 : 95) * (1 - phase);
 out property <color> canvas: pick(theme, #202020, #f1eee8, #e9dfcf, #000000, #07111f).mix(pick(old-theme, #202020, #f1eee8, #e9dfcf, #000000, #07111f), phase);
 out property <color> surface: pick(theme, #252525, #fffdf8, #f8efde, #0b0b0b, #0d1a2b).mix(pick(old-theme, #252525, #fffdf8, #f8efde, #0b0b0b, #0d1a2b), phase);
 out property <color> field: pick(theme, #2b2b2b, #f7f8f4, #fbf4e7, #161616, #13233a).mix(pick(old-theme, #2b2b2b, #f7f8f4, #fbf4e7, #161616, #13233a), phase);
 out property <color> ink: polarity-change ? readable-ink : pick(theme, #eeeeee, #253028, #253028, #f2f2f2, #f1f6fb).mix(pick(old-theme, #eeeeee, #253028, #253028, #f2f2f2, #f1f6fb), phase);
 out property <color> muted: polarity-change ? readable-ink : pick(theme, #aaaaaa, #657267, #657267, #a8abb1, #aab8c7).mix(pick(old-theme, #aaaaaa, #657267, #657267, #a8abb1, #aab8c7), phase);
 out property <color> edge: pick(theme, #424242, #d5ddd3, #d8c9ad, #2b2e33, #2a4564).mix(pick(old-theme, #424242, #d5ddd3, #d8c9ad, #2b2e33, #2a4564), phase);
 out property <color> accent: pick(theme, #9bc9ac, #2c7150, #2c7150, #73c7a4, #72c7bd).mix(pick(old-theme, #9bc9ac, #2c7150, #2c7150, #73c7a4, #72c7bd), phase);
 out property <color> accent-ink: polarity-change ? (accent-level >= 118 ? #000000 : #ffffff) : pick(theme, #14261b, #ffffff, #ffffff, #03140d, #052220).mix(pick(old-theme, #14261b, #ffffff, #ffffff, #03140d, #052220), phase);
 out property <color> selected: pick(theme, #344c3e, #e8f0e5, #eadfbb, #14261c, #173352).mix(pick(old-theme, #344c3e, #e8f0e5, #eadfbb, #14261c, #173352), phase);
}
component Action inherits Rectangle {
 in property <string> text;
 in property <string> hint: text;
 in property <bool> enabled: true;
 in property <bool> primary: false;
 in property <bool> selected: false;
 in property <bool> quiet: false;
 in property <bool> subtle: false;
 in property <bool> rtl: false;
 in property <int> leading-icon: 0;
 in property <bool> centered: true;
 in property <int> symbol: 0;
 out property <length> label-width: button-label.preferred-width;
 callback clicked();
 min-width: 28px; min-height: 26px; preferred-height: 34px; vertical-stretch: 0;
 border-radius: 6px; border-width: quiet && !(keys.has-focus && UiColors.keyboard-focus) ? 0px : 1px;
 border-color: keys.has-focus && UiColors.keyboard-focus ? UiColors.accent : UiColors.edge;
 background: primary ? UiColors.accent : selected ? (subtle ? UiColors.field : UiColors.selected) : touch.has-hover ? UiColors.field : transparent;
 opacity: enabled ? 1 : 0.45;
 accessible-role: button; accessible-label: root.symbol > 0 ? hint : text; accessible-description: hint; accessible-enabled: enabled;
 accessible-action-default => { if root.enabled { root.clicked(); } }
 forward-focus: keys;
 button-label := Text { x: root.leading-icon > 0 && !root.rtl ? 30px : 10px; width: max(0px, parent.width - (root.leading-icon > 0 ? 40px : 20px)); height: parent.height; text: root.symbol == 0 && (root.leading-icon == 0 || root.width >= 64px) ? root.text : ""; color: root.primary ? UiColors.accent-ink : root.quiet && !root.selected && !touch.has-hover ? UiColors.muted : UiColors.ink; font-size: root.subtle ? 12px : 13px; horizontal-alignment: root.centered ? center : root.rtl ? right : left; vertical-alignment: center; overflow: elide; }
 if root.leading-icon > 0 : Path { x: root.rtl ? parent.width - 25px : 8px; y: (parent.height - self.height) / 2; width: root.subtle ? 14px : 16px; height: self.width; commands: root.leading-icon == 8 ? "M 6 0 C 2.7 0 0 2.7 0 6 C 0 9.3 2.7 12 6 12 C 9.3 12 12 9.3 12 6 C 12 2.7 9.3 0 6 0 Z M 10.5 10.5 L 16 16" : root.leading-icon == 9 ? "M 1 9 C 1 4 4 1 8 1 C 12 1 15 4 15 9 M 1 9 L 1 15 L 5 15 L 5 9 Z M 11 9 L 15 9 L 15 15 L 11 15 Z" : "M 0 4 L 3 4 M 7 4 L 16 4 M 0 12 L 9 12 M 13 12 L 16 12 M 7 4 A 2 2 0 1 1 3 4 A 2 2 0 1 1 7 4 M 13 12 A 2 2 0 1 1 9 12 A 2 2 0 1 1 13 12"; stroke: root.subtle && !root.selected && !touch.has-hover ? UiColors.muted : UiColors.ink; stroke-width: root.subtle ? 1.2px : 1.4px; fill: transparent; }
 if root.symbol == 1 : Path { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: root.subtle ? 14px : 17px; height: self.width; commands: "M 1 7 L 1 1 L 7 1 M 11 1 L 17 1 L 17 7 M 17 11 L 17 17 L 11 17 M 7 17 L 1 17 L 1 11"; stroke: UiColors.ink; stroke-width: 1.5px; fill: transparent; }
 if root.symbol == 12 : Path { x: (parent.width - 10px) / 2; y: (parent.height - 10px) / 2; width: 10px; height: 10px; commands: "M 0 0 L 10 10 M 10 0 L 0 10"; stroke: UiColors.muted; stroke-width: 1.2px; fill: transparent; }
 if root.symbol == 3 || root.symbol == 4 : Path { x: (parent.width - 7px) / 2; y: (parent.height - 12px) / 2; width: 7px; height: 12px; commands: root.symbol == 3 ? "M 6 0 L 0 6 L 6 12" : "M 0 0 L 6 6 L 0 12"; stroke: UiColors.ink; stroke-width: 1.5px; fill: transparent; }
 if root.symbol == 5 : Path { x: (parent.width - 16px) / 2; y: (parent.height - 12px) / 2; width: 16px; height: 12px; commands: "M 0 0 L 16 0 M 0 6 L 16 6 M 0 12 L 16 12"; stroke: UiColors.ink; stroke-width: 1.4px; fill: transparent; }
 if root.symbol == 6 : Path { x: (parent.width - 10px) / 2; y: (parent.height - 14px) / 2; width: 10px; height: 14px; commands: "M 1 0 L 1 14 M 9 0 L 9 14"; stroke: UiColors.ink; stroke-width: 2px; fill: transparent; }
 if root.symbol == 7 : Path { x: (parent.width - 11px) / 2; y: (parent.height - 14px) / 2; width: 11px; height: 14px; commands: "M 0 0 L 11 7 L 0 14 Z"; stroke: UiColors.ink; stroke-width: 1px; fill: transparent; }
 if root.symbol == 8 : Path { x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2; width: 16px; height: 16px; commands: "M 6 0 C 2.7 0 0 2.7 0 6 C 0 9.3 2.7 12 6 12 C 9.3 12 12 9.3 12 6 C 12 2.7 9.3 0 6 0 Z M 10.5 10.5 L 16 16"; stroke: UiColors.ink; stroke-width: 1.5px; fill: transparent; }
 if root.symbol == 9 : Path { x: (parent.width - 18px) / 2; y: (parent.height - 16px) / 2; width: 18px; height: 16px; commands: "M 1 9 C 1 4 4 1 9 1 C 14 1 17 4 17 9 M 1 9 L 1 15 L 5 15 L 5 9 Z M 13 9 L 17 9 L 17 15 L 13 15 Z"; stroke: UiColors.ink; stroke-width: 1.5px; fill: transparent; }
 if root.symbol == 10 : Path { x: (parent.width - 18px) / 2; y: (parent.height - 16px) / 2; width: 18px; height: 16px; commands: "M 0 4 L 3 4 M 7 4 L 16 4 M 0 12 L 9 12 M 13 12 L 16 12 M 7 4 A 2 2 0 1 1 3 4 A 2 2 0 1 1 7 4 M 13 12 A 2 2 0 1 1 9 12 A 2 2 0 1 1 13 12"; stroke: UiColors.ink; stroke-width: 1.5px; fill: transparent; }
 if root.symbol == 2 : Path { x: (parent.width - 12px) / 2; y: (parent.height - 6px) / 2; width: 12px; height: 6px; commands: "M 0 6 L 6 0 L 12 6"; stroke: UiColors.ink; stroke-width: 1.5px; fill: transparent; }
 Tooltip { Text { text: root.hint; color: UiColors.ink; max-width: 320px; wrap: word-wrap; } }
 keys := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
 touch := TouchArea { enabled: root.enabled; clicked => { keys.focus(); root.clicked(); } }
}
component HeaderAction inherits Action {
 subtle: true; quiet: true; min-height: 24px; max-height: 24px; preferred-height: 24px;
}
component SectionHeading inherits Text {
 color: UiColors.muted; font-size: 12px; font-weight: 600; height: 22px; vertical-alignment: center;
}
component SettingsGroup inherits Rectangle {
 vertical-stretch: 0;
 background: UiColors.field.with-alpha(0.35); border-radius: 8px;
 border-width: 1px; border-color: UiColors.edge.with-alpha(0.5);
 VerticalLayout { padding: 10px; spacing: 6px; @children }
}
component SettingsLink inherits Rectangle {
 in property <string> text; in property <string> detail; in property <bool> rtl;
 callback clicked();
 preferred-height: 36px; min-height: 36px; max-height: 36px; vertical-stretch: 0; border-radius: 5px;
 background: touch.has-hover || (keys.has-focus && UiColors.keyboard-focus) ? UiColors.field : transparent;
 accessible-role: button; accessible-label: text; accessible-description: detail; accessible-action-default => {root.clicked();}
 forward-focus: keys;
 Text { x: root.rtl && root.detail != "" ? 64px : 8px; y: 0px; width: parent.width - (root.detail == "" ? 16px : 72px); height: parent.height; text: root.text; color: UiColors.ink; font-size: 13px; horizontal-alignment: root.rtl ? right : left; vertical-alignment: center; overflow: elide; }
 if root.detail != "" : Text { x: root.rtl ? 8px : parent.width - 54px; y: 0px; width: 46px; height: parent.height; text: root.detail; color: UiColors.muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
 keys := FocusScope { key-pressed(e) => {if e.text == Key.Return || e.text == " " {root.clicked(); return accept;} return reject;} }
 touch := TouchArea { clicked => {keys.focus();root.clicked();} }
 Tooltip {Text {text: root.text; color: UiColors.ink;} }
}
component CaptionButton inherits Rectangle {
 in property <int> kind; in property <bool> maximized; in property <string> label;
 callback clicked(); width: 44px; height: 28px;
 background: touch.has-hover ? (kind == 2 ? #c42b1c : UiColors.field) : transparent;
 private property <color> glyph: touch.has-hover && kind == 2 ? #ffffff : UiColors.ink;
 accessible-role: button; accessible-label: label; accessible-action-default => { root.clicked(); }
 forward-focus: keys;
 if kind == 0 : Path { x: 17px; y: 14px; width: 10px; height: 1px; commands: "M 0 0 L 10 0"; stroke: root.glyph; stroke-width: 1px; }
 if kind == 1 : Path { x: 17px; y: 9px; width: 10px; height: 10px; commands: root.maximized ? "M 0 2 L 8 2 L 8 10 L 0 10 Z M 2 2 L 2 0 L 10 0 L 10 8 L 8 8" : "M 0 0 L 10 0 L 10 10 L 0 10 Z"; stroke: root.glyph; stroke-width: 1px; fill: transparent; }
 if kind == 2 : Path { x: 17px; y: 9px; width: 10px; height: 10px; commands: "M 0 0 L 10 10 M 10 0 L 0 10"; stroke: root.glyph; stroke-width: 1px; }
 if keys.has-focus : Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; border-width: 1px; border-color: UiColors.muted; background: transparent; }
 Tooltip { Text { text: root.label; color: UiColors.ink; } }
 keys := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.clicked(); return accept; } return reject; } }
 touch := TouchArea { clicked => { root.clicked(); } }
}
component QuietLink inherits Action {
 quiet: true;
 Rectangle { x: (parent.width - self.width) / 2; y: parent.height - 3px; width: max(0px, min(root.label-width, parent.width - 16px)); height: 1px; background: UiColors.muted.with-alpha(0.55); }
}
component SearchTab inherits Rectangle {
 in property <string> text; in property <bool> selected; callback clicked();
 preferred-height: 34px; min-height: 34px; max-height: 34px; min-width: 46px; border-radius: 6px;
 background: root.selected ? UiColors.surface : touch.has-hover || (keys.has-focus && UiColors.keyboard-focus) ? UiColors.surface.with-alpha(0.5) : transparent;
 border-width: root.selected ? 1px : 0px; border-color: UiColors.edge;
 drop-shadow-blur: root.selected ? 3px : 0px; drop-shadow-offset-y: root.selected ? 1px : 0px; drop-shadow-color: root.selected ? #0000001f : transparent;
