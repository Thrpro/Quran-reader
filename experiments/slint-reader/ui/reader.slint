 changed panel => { if root.panel != "shortcuts" { root.shortcut-capture = -1; root.shortcut-status = ""; } if root.panel == "" || root.panel == "search" || root.panel == "listen" || root.panel == "settings" || root.panel == "study" { root.panel-return = ""; } if root.panel == "listen" || root.panel == "downloads" { root.downloads-refresh(); } if root.panel == "search" && root.sections-en.juz.length == 0 { root.sections-needed(); } if root.panel != "" { root.displayed-panel = root.panel; } root.hover-left(); if root.panel != "search" && root.onboarding-complete {reader-keys.focus();} if root.study-space == last-study-space { root.render-requested(root.canvas-w, root.canvas-h); } }
 private property <length> last-study-space: 0px;
 changed study-space => { root.last-study-space = root.study-space; root.start-book-slide(); }
 private property <bool> player-docked: canvas.width - root.image-w * 1px < 408px || !root.player-expanded || (root.panel != "" && root.panel != "listen");
