        Rectangle { border-radius: 8px; border-width: 1px; border-color: search-field.has-focus ? UiColors.muted.with-alpha(0.7) : UiColors.edge; }
        focus-again := Timer { interval: 50ms; running: false; private property <int> tries: 0; triggered => { self.tries += 1; if root.panel == "search" && !search-field.has-focus { search-field.focus(); } if self.tries >= 8 || root.panel != "search" { self.running = false; self.tries = 0; } } }
       }
