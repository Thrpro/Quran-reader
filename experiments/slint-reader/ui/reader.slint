        Text { layout-order: 1; text: root.arabic ? "التصفح والانتقال" : "Browse and go to"; color: UiColors.muted; font-size: 12px; vertical-alignment: center; }
        Rectangle { layout-order: 2; horizontal-stretch: 1; Rectangle { y: parent.height / 2; height: 1px; background: UiColors.edge; } }
       }
       Rectangle { preferred-height: 44px; min-height: 44px; max-height: 44px; border-radius: 9px; background: UiColors.field; border-width: 1px; border-color: UiColors.edge;
