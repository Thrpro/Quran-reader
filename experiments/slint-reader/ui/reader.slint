         HorizontalLayout { padding-left: 12px; padding-right: 8px; padding-top: 11px; padding-bottom: 11px; spacing: 8px;
          VerticalLayout { layout-order: 1; horizontal-stretch: 1; alignment: center; spacing: 2px;
           Text { text: entry.title; color: UiColors.ink; font-size: 13px; font-weight: 600; horizontal-alignment: root.arabic ? right : left; overflow: elide; }
           Text { text: entry.detail; color: UiColors.muted; font-size: 11px; horizontal-alignment: root.arabic ? right : left; overflow: elide; }
          }
          Action { layout-order: root.arabic ? 0 : 2; width: 30px; height: 30px; symbol: 12; quiet: true; text: root.arabic ? "حذف" : "Delete"; hint: (root.arabic ? "حذف " : "Delete ") + entry.title; clicked => { root.download-delete(index); } }
         }
        }
        SectionHeading { text: root.arabic ? "تنزيل سورة" : "Download a surah"; horizontal-alignment: root.arabic ? right : left; }
        SettingsGroup {
         Text { text: root.arabic ? "القارئ" : "Reciter"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         ChoiceField { rtl: root.arabic; label: root.arabic ? "اختيار القارئ" : "Choose reciter"; model: root.reciters; current-index <=> root.reciter-index; enabled: root.reciters.length > 0 && !root.download-busy; selected(i) => { root.reciter-changed(i); } }
         Text { text: root.arabic ? "السورة" : "Surah"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         ChoiceField { rtl: root.arabic; label: root.arabic ? "السورة المراد تنزيلها" : "Surah to download"; model: root.surah-names; current-index <=> root.download-surah; enabled: !root.download-busy && root.surah-names.length > 0; }
         if !root.download-busy : Action { height: 36px; primary: true; text: root.arabic ? "تنزيل السورة" : "Download surah"; enabled: root.reciters.length > 0 && root.surah-names.length > 0; clicked => { root.download-start(root.download-surah); } }
         if root.download-busy : HorizontalLayout { height: 36px; spacing: 10px;
          Rectangle { layout-order: root.arabic ? 2 : 0; horizontal-stretch: 1;
           Rectangle { y: (parent.height - 6px) / 2; height: 6px; border-radius: 3px; background: UiColors.edge;
            Rectangle { x: root.arabic ? parent.width - self.width : 0px; width: parent.width * root.download-progress; border-radius: 3px; background: UiColors.accent; }
           }
          }
          Text { layout-order: 1; width: 40px; text: round(root.download-progress * 100) + "%"; color: UiColors.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
          Action { layout-order: root.arabic ? 0 : 2; width: 76px; text: root.arabic ? "إلغاء" : "Cancel"; clicked => { root.download-cancel(); } }
         }
         if root.download-status != "" : Text { text: root.download-status; color: UiColors.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: root.arabic ? right : left; }
        }
        Rectangle {preferred-height: 0px; vertical-stretch: 1; background: transparent;}
       }
      }
      if root.panel-kind == "study" : VerticalLayout {
       spacing: 8px;
       ChoiceField { init => { root.study-choice-height = self.height / 1px; } changed height => { root.study-choice-height = self.height / 1px; } rtl: root.arabic; label: root.arabic ? "مصدر التفسير" : "Tafsir source"; model: root.arabic ? ["المختصر في التفسير", "تفسير السعدي"] : ["Saheeh International · translation"]; current-index: root.arabic ? min(root.study-source, 1) : 0; selected(i) => { root.study-source = root.arabic ? i : 2; root.study-source-changed(root.study-source); reader-keys.focus(); } }
       HorizontalLayout { height: 30px; spacing: 8px;
        Action { layout-order: root.arabic ? 2 : 0; width: 32px; text: "‹"; hint: root.arabic ? "الآية السابقة" : "Previous ayah"; clicked => { root.study-step(-1); reader-keys.focus(); } }
        Text { layout-order: 1; text: root.study-title; color: UiColors.accent; font-size: 13px; font-weight: 600; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; overflow: elide; Tooltip { Text { text: root.study-title; color: UiColors.ink; max-width: 320px; wrap: word-wrap; } } }
        Action { layout-order: root.arabic ? 0 : 2; width: 32px; text: "›"; hint: root.arabic ? "الآية التالية" : "Next ayah"; clicked => { root.study-step(1); reader-keys.focus(); } }
       }
       HorizontalLayout { height: 24px;
        QuietLink { width: 104px; text: root.arabic ? "حجم النص" : "Text size"; clicked => { root.size-tools = !root.size-tools; } }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if root.audio-active : QuietLink { width: 154px; text: root.follow-recitation ? (root.arabic ? "متابعة التلاوة: مفعّلة" : "Following recitation") : (root.arabic ? "متابعة التلاوة" : "Follow recitation"); hint: root.arabic ? "إظهار تفسير الآية التي تُتلى تلقائيًا" : "Automatically show the study text for the verse being recited"; clicked => { root.follow-recitation = !root.follow-recitation; root.preferences-changed(); } }
       }
       if root.size-tools : HorizontalLayout { height: 32px; spacing: 8px;
        Action { layout-order: root.arabic ? 2 : 0; width: 44px; text: "A−"; hint: root.arabic ? "تصغير نص التفسير" : "Smaller study text"; enabled: root.study-size > 14; clicked => { root.study-size = max(14, root.study-size - 1); root.preferences-changed(); } }
        Text { layout-order: 1; text: round(root.study-size); color: UiColors.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
        Action { layout-order: root.arabic ? 0 : 2; width: 44px; text: "A+"; hint: root.arabic ? "تكبير نص التفسير" : "Larger study text"; enabled: root.study-size < 26; clicked => { root.study-size = min(26, root.study-size + 1); root.preferences-changed(); } }
       }
       Rectangle { height: 1px; background: UiColors.edge; }
       body := ReadingBody { body: root.study-body; text-size: root.study-size; rtl: root.arabic; vertical-stretch: 1; }
       Rectangle { height: 16px; background: transparent; Text { width: parent.width; height: parent.height; text: root.arabic ? "مرّر لقراءة بقية التفسير" : "Scroll to continue reading"; opacity: body.overflowing ? 1 : 0; color: UiColors.muted; font-size: 11px; horizontal-alignment: root.arabic ? right : left; } }
       Text { text: root.arabic ? "المصدر: المكتبة القرآنية الشاملة" : "Source: Quranic Universal Library"; color: UiColors.muted; font-size: 10px; horizontal-alignment: root.arabic ? right : left; }
       if root.audio-active : Rectangle { height: 1px; background: UiColors.edge; }
       if root.audio-active : HorizontalLayout { height: 24px;
        Text { text: root.audio-title; color: UiColors.muted; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: root.arabic ? right : left; overflow: elide; }
        Action { width: 34px; quiet: true; enabled: !root.download-busy && !root.current-saved; symbol: root.current-saved ? 15 : 14; text: root.arabic ? "تنزيل السورة" : "Download surah"; hint: root.current-saved ? (root.arabic ? "هذه السورة محفوظة للاستماع دون اتصال" : "This surah is saved for offline listening") : (root.arabic ? "نزّل هذه السورة لتستمع إليها دون اتصال" : "Download this surah to listen offline"); clicked => { root.download-current(); } }
        Action { width: 34px; quiet: true; symbol: 5; text: root.arabic ? "إعدادات الاستماع" : "Listening settings"; hint: root.arabic ? "إعدادات الاستماع" : "Listening settings"; clicked => { root.panel = "listen"; } }
       }
       if root.audio-active : Transport { height: 124px; rtl: root.arabic; paused: root.audio-paused; terminal: root.audio-terminal; can-seek: root.audio-can-seek; loading: root.audio-loading; clock: root.audio-clock; status: root.audio-status; progress: root.audio-progress; toggle => { root.audio-toggle(); } end => { root.audio-end(); } skip(s) => { root.audio-skip(s); } seek(v) => { root.audio-seek(v); } show-ayah => { root.show-recited-ayah(); } }

      }
      if root.panel-kind == "bookmarks" : ScrollView { horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: as-needed;
       VerticalLayout { spacing: 8px;
        for mark[index] in root.bookmarks : Rectangle { height: 66px; border-radius: 8px; background: UiColors.field;
         HorizontalLayout { padding: 8px; spacing: 8px;
          VerticalLayout { layout-order: root.arabic ? 1 : 0; horizontal-stretch: 1; spacing: 3px;
           Action { text: mark.title; rtl: root.arabic; centered: false; quiet: true; clicked => { root.choose-bookmark(index); root.panel = ""; reader-keys.focus(); } }
           Text { text: mark.detail; color: UiColors.muted; font-size: 11px; horizontal-alignment: root.arabic ? right : left; overflow: elide; }
          }
          Action { layout-order: root.arabic ? 0 : 1; width: 64px; text: root.arabic ? "إزالة" : "Remove"; clicked => { root.remove-bookmark(index); } }
         }
        }
        if root.bookmarks.length == 0 : Text { text: root.arabic ? "لم تحفظ علامات بعد. اضغط بزر الفأرة الأيمن على آية لحفظها." : "No saved bookmarks yet. Right-click a verse to save one."; color: UiColors.muted; font-size: 13px; wrap: word-wrap; horizontal-alignment: root.arabic ? right : left; }
        Rectangle { vertical-stretch: 1; background: transparent; }
       }
      }
      if root.panel-kind == "listen" : VerticalLayout { spacing: 9px;
       ScrollView { horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: as-needed; vertical-stretch: 1;
        VerticalLayout { spacing: 9px;
         Text { height: 18px; text: root.arabic ? "القارئ" : "Reciter"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         ChoiceField { rtl: root.arabic; label: root.arabic ? "اختيار القارئ" : "Choose reciter"; model: root.reciters; current-index <=> root.reciter-index; enabled: root.reciters.length > 0; selected(i) => { root.reciter-changed(i); reader-keys.focus(); } }
         Text { height: 18px; text: root.arabic ? "مدى التلاوة" : "Listening range"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         ChoiceField { rtl: root.arabic; label: root.arabic ? "مدى التلاوة" : "Listening range"; model: root.arabic ? ["من الآية إلى نهاية السورة", "هذه الآية فقط", "حتى نهاية الصفحة", "السورة كاملة", "حتى نهاية القرآن"] : ["From the ayah to the end of the surah", "This ayah only", "To the end of the page", "The whole surah", "To the end of the Quran"]; current-index <=> root.listen-scope; }
         if root.audio-active && !root.current-saved : Action { height: 34px; text: root.download-busy ? (root.arabic ? "جارٍ تنزيل السورة… " : "Downloading the surah… ") + round(root.download-progress * 100) + "%" : (root.arabic ? "نزّل السورة التي تستمع إليها" : "Download the surah you're listening to"); enabled: !root.download-busy; clicked => { root.download-current(); } }
         Action { height: 36px; text: root.arabic ? "بدء التلاوة" : "Start recitation"; primary: true; enabled: root.reciters.length > 0; clicked => { root.play-selected(); } }
         Rectangle { height: 1px; background: UiColors.edge; }
         Text { height: 18px; text: root.arabic ? "سرعة التلاوة" : "Playback speed"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         ChoiceField { rtl: root.arabic; label: root.arabic ? "سرعة التلاوة" : "Playback speed"; model: ["0.75×", "1×", "1.25×", "1.5×", "1.75×", "2×"]; current-index: root.playback-rate < 0.9 ? 0 : root.playback-rate < 1.1 ? 1 : root.playback-rate < 1.4 ? 2 : root.playback-rate < 1.6 ? 3 : root.playback-rate < 1.9 ? 4 : 5; selected(i) => { root.playback-rate = i == 0 ? 0.75 : i == 1 ? 1 : i == 2 ? 1.25 : i == 3 ? 1.5 : i == 4 ? 1.75 : 2; root.audio-rate(root.playback-rate); reader-keys.focus(); } }
         ToggleRow { text: root.arabic ? "تذكّر سرعة التلاوة" : "Remember playback speed"; hint: root.arabic ? "عند إيقاف الخيار تبدأ التلاوة الجديدة بسرعة 1×" : "When off, new recitations start at 1×"; rtl: root.arabic; checked <=> root.remember-speed; toggled => { root.preferences-changed(); } }
         Text { height: 18px; text: (root.arabic ? "مستوى الصوت · " : "Volume · ") + round(root.volume) + "%"; color: UiColors.muted; font-size: 12px; horizontal-alignment: root.arabic ? right : left; }
         SeekTrack { value: root.volume / 100; rtl: root.arabic; label: root.arabic ? "مستوى الصوت" : "Volume"; seek(v) => { root.volume = v * 100; root.audio-volume(root.volume); } }
         HorizontalLayout { height: 16px; Text { text: root.arabic ? "100%" : "0%"; color: UiColors.muted; font-size: 10px; horizontal-stretch: 1; } Text { text: root.arabic ? "0%" : "100%"; color: UiColors.muted; font-size: 10px; horizontal-stretch: 1; horizontal-alignment: right; } }
         Rectangle { height: 1px; background: UiColors.edge; }
         SettingsLink { text: root.arabic ? "إدارة التنزيلات" : "Download manager"; detail: root.downloads.length; rtl: root.arabic; clicked => { root.panel-return = "listen"; root.panel = "downloads"; } }
         Rectangle { preferred-height: 0px; vertical-stretch: 1; background: transparent; }
        }
       }
       if root.audio-active : Rectangle { height: 1px; background: UiColors.edge; }
       if root.audio-active : Transport { rtl: root.arabic; paused: root.audio-paused; terminal: root.audio-terminal; can-seek: root.audio-can-seek; loading: root.audio-loading; clock: root.audio-clock; status: root.audio-status; progress: root.audio-progress; toggle => { root.audio-toggle(); } end => { root.audio-end(); } skip(s) => { root.audio-skip(s); } seek(v) => { root.audio-seek(v); } show-ayah => { root.show-recited-ayah(); } }
      }
     }
    }    // Open panels dock playback into the toolbar, never over study text.
    Timer { interval: 6s; running: root.audio-finished && root.panel != "listen" && root.panel != "study"; triggered => { root.audio-end(); } }
    if root.audio-active && root.player-expanded && !root.player-docked && root.panel == "" : Rectangle {
     width: min(264px, max(188px, (canvas.width - root.image-w * 1px) / 2 - 16px)); height: (root.audio-status == "" ? 186px : 202px) + (root.download-busy ? 18px : 0px);
     x: root.arabic ? canvas.width - self.width - 10px : 10px; y: canvas.height - self.height - 10px;
     border-radius: 12px; border-width: 1px; border-color: UiColors.edge; background: UiColors.surface;
     VerticalLayout { padding: 11px; spacing: 7px;
      HorizontalLayout { height: 26px; spacing: 6px;
       Text { text: root.audio-title; color: UiColors.ink; font-size: 13px; font-weight: 600; horizontal-stretch: 1; horizontal-alignment: root.arabic ? right : left; vertical-alignment: center; overflow: elide; Tooltip { Text { text: root.audio-title; color: UiColors.ink; max-width: 320px; wrap: word-wrap; } } }
       Action { width: 34px; enabled: !root.download-busy && !root.current-saved; symbol: root.current-saved ? 15 : 14; quiet: true; text: root.arabic ? "تنزيل السورة" : "Download surah"; hint: root.current-saved ? (root.arabic ? "هذه السورة محفوظة للاستماع دون اتصال" : "This surah is saved for offline listening") : root.download-busy ? (root.arabic ? "جارٍ التنزيل… " : "Downloading… ") + round(root.download-progress * 100) + "%" : (root.arabic ? "نزّل هذه السورة لتستمع إليها دون اتصال" : "Download this surah to listen offline"); clicked => { root.download-current(); } }
       Action { width: 34px; symbol: 5; text: root.arabic ? "إعدادات الاستماع" : "Listening settings"; hint: root.arabic ? "إعدادات الاستماع" : "Listening settings"; clicked => { root.panel = "listen"; } }
       Action { width: 28px; symbol: 2; text: root.arabic ? "تصغير المشغّل" : "Minimize player"; hint: root.arabic ? "تصغير المشغّل إلى شريط العنوان" : "Minimize player to the title bar"; clicked => { root.player-expanded = false; } }
      }
      Transport { rtl: root.arabic; paused: root.audio-paused; terminal: root.audio-terminal; can-seek: root.audio-can-seek; loading: root.audio-loading; clock: root.audio-clock; status: root.audio-status; progress: root.audio-progress; toggle => { root.audio-toggle(); } end => { root.audio-end(); } skip(s) => { root.audio-skip(s); } seek(v) => { root.audio-seek(v); } show-ayah => { root.show-recited-ayah(); } }
      if root.download-busy : Text { text: (root.arabic ? "جارٍ تنزيل السورة… " : "Downloading the surah… ") + round(root.download-progress * 100) + "%"; color: UiColors.muted; font-size: 11px; horizontal-alignment: center; }
     }
    }
    if root.fullscreen && root.panel == "" : Action { x: root.arabic ? canvas.width - self.width - 8px : 8px; y: 5px; width: 128px; height: 30px; quiet: true; text: root.arabic ? "إنهاء ملء الشاشة" : "Exit full screen"; hint: root.arabic ? "إنهاء ملء الشاشة (Escape)" : "Exit full screen (Escape)"; clicked => { root.fullscreen-requested(); } }
    if root.fullscreen && root.panel == "" : VerticalLayout { x: root.arabic ? canvas.width - self.width - 4px : 4px; y: 42px; width: 44px; height: root.audio-active && root.player-docked ? 200px : 120px; spacing: 4px;
     Action { height: 36px; symbol: 8; quiet: true; selected: root.panel == "search"; text: root.arabic ? "بحث" : "Search"; hint: root.arabic ? "بحث" : "Search"; clicked => { if root.panel == "search" { root.panel = ""; } else { root.open-search(); } } }
     Action { height: 36px; symbol: 9; quiet: true; selected: root.panel == "listen"; text: root.arabic ? "استماع" : "Listen"; hint: root.arabic ? "الاستماع والتلاوة" : "Listening and recitation"; clicked => { root.panel = root.panel == "listen" ? "" : "listen"; } }
     Action { height: 36px; symbol: 10; quiet: true; selected: root.panel == "settings"; text: root.arabic ? "الخيارات" : "Options"; hint: root.arabic ? "الخيارات" : "Options"; clicked => { root.panel = root.panel == "settings" ? "" : "settings"; } }
     if root.audio-active && root.player-docked : Action { height: 36px; symbol: root.audio-paused || root.audio-terminal ? 7 : 6; selected: true; enabled: !root.audio-loading; text: root.audio-terminal ? (root.arabic ? "تشغيل مجددًا" : "Play again") : root.audio-paused ? (root.arabic ? "متابعة التلاوة" : "Resume recitation") : (root.arabic ? "إيقاف مؤقت" : "Pause recitation"); clicked => { root.audio-toggle(); } }
     if root.audio-active && root.player-docked : Action { height: 36px; text: root.arabic ? "إنهاء" : "End"; hint: root.arabic ? "إنهاء التلاوة وإغلاق المشغّل" : "End recitation and close the player"; clicked => { root.audio-end(); } }
    }
    if root.context-open : TouchArea { clicked => { root.context-open = false; reader-keys.focus(); } }
    if root.context-open : Rectangle {
     width: 300px; height: menu-column.preferred-height;
     init => { root.menu-x = self.x / 1px; root.menu-y = self.y / 1px; root.menu-h = self.height / 1px; }
     changed height => { root.menu-h = self.height / 1px; } changed x => { root.menu-x = self.x / 1px; } changed y => { root.menu-y = self.y / 1px; }
     x: ((root.context-x + root.canvas-x) * 1px).clamp(10px, max(10px, canvas.width - self.width - 10px)); y: (root.context-y * 1px).clamp(10px, max(10px, canvas.height - self.height - 10px));
     border-radius: 12px; border-width: 1px; border-color: UiColors.edge; background: UiColors.surface;
     drop-shadow-blur: 16px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000030;
     menu-column := VerticalLayout { padding: 8px; spacing: 2px;
      HorizontalLayout { height: 32px; padding-left: 8px; padding-right: 2px; spacing: 6px;
       Text { layout-order: root.arabic ? 1 : 0; horizontal-stretch: 1; text: root.context-title; color: UiColors.muted; font-size: 12px; font-weight: 600; horizontal-alignment: root.arabic ? right : left; vertical-alignment: center; overflow: elide; }
       Action { layout-order: root.arabic ? 0 : 1; width: 28px; min-height: 28px; max-height: 28px; quiet: true; symbol: 12; text: root.arabic ? "إغلاق" : "Close"; clicked => { root.context-open = false; reader-keys.focus(); } }
      }
      MenuItem { icon: 0; rtl: root.arabic; text: root.arabic ? "التفسير" : "Tafsir"; detail: root.arabic ? "اقرأ تفسير الآية" : "Read the explanation"; clicked => { root.context-open = false; root.study-selected(); } }
      HorizontalLayout { spacing: 2px;
       MenuItem { layout-order: root.arabic ? 1 : 0; horizontal-stretch: 1; icon: 1; rtl: root.arabic; text: root.arabic ? "الاستماع من هنا" : "Listen from here"; detail: root.arabic ? "حتى نهاية السورة" : "Continue to the end of this surah"; clicked => { root.context-open = false; root.listen-selected(0); } }
       Action { layout-order: root.arabic ? 0 : 1; width: 34px; min-height: 52px; quiet: true; selected: root.listen-more; subtle: true; symbol: root.listen-more ? 2 : 13; text: root.arabic ? "خيارات استماع أخرى" : "More listening options"; clicked => { root.listen-more = !root.listen-more; } }
      }
      if root.listen-more : Rectangle { height: 4 * 36px + 6px;
       Rectangle { x: root.arabic ? parent.width - 23px : 21px; y: 3px; width: 2px; height: parent.height - 6px; border-radius: 1px; background: UiColors.edge; }
       VerticalLayout { x: root.arabic ? 0px : 32px; y: 3px; width: parent.width - 32px; height: parent.height - 6px; spacing: 0px;
        for option[i] in (root.arabic ? ["هذه الآية فقط", "حتى نهاية الصفحة", "السورة كاملة", "حتى نهاية القرآن"] : ["This ayah only", "To the end of the page", "The whole surah", "To the end of the Quran"]) : MenuItem { rtl: root.arabic; text: option; clicked => { root.context-open = false; root.listen-selected(i + 1); } }
       }
      }
      MenuItem { icon: 2; rtl: root.arabic; text: root.bookmark-present ? (root.arabic ? "إزالة العلامة" : "Remove bookmark") : (root.arabic ? "حفظ علامة" : "Save bookmark"); detail: root.bookmark-present ? (root.arabic ? "إزالتها من العلامات المحفوظة" : "Remove it from Saved bookmarks") : (root.arabic ? "تجدها لاحقًا في العلامات المحفوظة" : "Find it later in Saved bookmarks"); clicked => { root.context-open = false; root.bookmark-selected(); } }
     }
    }
    if root.notice != "" || root.notification != "" : Rectangle {
     width: min(380px, canvas.width - 30px); height: 38px; x: (canvas.width - self.width) / 2; y: canvas.height - self.height - 12px;
     border-radius: 8px; border-width: 1px; border-color: UiColors.edge; background: UiColors.surface;
     Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.notice != "" ? root.notice : root.notification; color: UiColors.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
   }

  }
 }
 // The tour runs on the live app. It never dims or blocks anything: a ring marks
 // the part being shown and a small card sits beside it. The title bar stays
 // usable throughout, and the card steps aside while a panel is open.
 if !root.onboarding-complete : tour := Rectangle {
  x: 0px; y: 0px; width: root.width; height: root.height;
  init => { root.panel = ""; root.context-open = false; tour-keys.focus(); }
  private property <int> steps: 6;
  private property <int> step: root.onboarding-step;
  private property <float> top: root.canvas-y + 1;
  private property <int> start-page: root.page;
  private property <bool> turned: self.step == 1 && root.page != self.start-page && !root.drag-active && !root.turn-running;
  private property <[float]> head-x: root.arabic ? [root.nav-x + 170, root.nav-x + 88, root.nav-x] : [root.nav-x, root.nav-x + 82, root.nav-x + 164];
  private property <bool> header-step: self.step >= 3 && !root.fullscreen;
  // The marked area in window coordinates; zero width for none.
  private property <float> tx: self.step == 1 ? root.raster-canvas-x + root.image-x + root.book-x - 6
     : self.step == 2 ? root.menu-x - 5
     : self.header-step ? self.head-x[self.step - 3] - 3 : 0;
  private property <float> ty: self.step == 1 ? self.top + root.image-y + root.book-y + root.book-h - 150
     : self.step == 2 ? self.top + root.menu-y - 5
     : self.header-step ? 1 : 0;
  private property <float> tw: self.step == 1 ? 156 : self.step == 2 ? 310 : self.header-step ? (self.step == 5 ? 92 : 86) : 0;
  private property <float> th: self.step == 1 ? 156 : self.step == 2 ? (root.context-open ? root.menu-h + 10 : 0) : self.header-step ? 27 : 0;
  private property <bool> marked: self.tw > 0 && self.th > 0;
  function finish() {
   root.context-open = false;
   if root.drag-active { root.end-page-drag(false); }
   root.onboarding-complete = true; root.onboarding-step = 0; root.preferences-changed(); reader-keys.focus();
  }
  function show(n: int) {
   if root.drag-active { root.end-page-drag(false); }
   root.context-open = false; root.panel = "";
   root.onboarding-step = n;
   peek.ticks = 0; peek.running = n == 1;
   menu-try.tries = 0; menu-try.asked = 0; menu-try.running = n == 2;
   if n == 1 { self.start-page = root.page; }
   tour-keys.focus();
  }
  function next() { if self.step >= self.steps - 1 { self.finish(); } else { self.show(self.step + 1); } }
  function back() { if self.step > 0 { self.show(self.step - 1); } }
  tour-keys := FocusScope {
   width: 0px; height: 0px;
   key-pressed(event) => {
    if event.text == Key.Escape { tour.finish(); return accept; }
    if event.text == Key.Return { tour.next(); return accept; }
    return reject;
   }
  }
  // Step 1 shows a page turn once: the corner lifts a little and settles back.
  peek := Timer {
   interval: 30ms; running: false;
   in-out property <int> ticks: 0;
   triggered => {
    if tour.step != 1 || !root.motion-enabled { if root.drag-active && self.ticks > 0 { root.end-page-drag(false); } self.running = false; return; }
    self.ticks += 1;
    if self.ticks == 16 && !root.drag-active && !root.turn-running { root.turn-top = false; root.begin-page-drag(1); }
    if self.ticks > 16 && self.ticks <= 42 && root.drag-active { root.drag-progress = 0.2 * Math.sin((self.ticks - 16) / 26 * 90deg); }
    if self.ticks == 60 { if root.drag-active { root.end-page-drag(false); } self.running = false; }
   }
  }
  // Step 2 opens the real ayah menu, waiting for a page turn or redraw to finish.
  menu-try := Timer {
   interval: 250ms; running: false;
   in-out property <int> tries: 0;
   in-out property <int> asked: 0;
   triggered => {
    // Stop for good once it has opened, so it never opens again by itself.
    if tour.step != 2 || root.context-open || self.tries >= 16 || self.asked >= 3 { self.running = false; return; }
    self.tries += 1;
    if root.drag-active { root.end-page-drag(false); }
    if self.tries >= 2 && !root.render-busy && !root.turn-running && !root.drag-active && !root.drag-canceling && !root.book-sliding {
     self.asked += 1;
     root.context-ayah(root.image-x + root.book-x + root.book-w * 0.25, root.image-y + root.book-y + root.book-h * 0.42);
    }
   }
  }
  if tour.marked : Rectangle { x: tour.tx * 1px; y: tour.ty * 1px; width: tour.tw * 1px; height: tour.th * 1px; border-radius: tour.header-step ? 8px : 14px; border-width: 2px; border-color: UiColors.accent; }
  if tour.marked : Rectangle { x: (tour.tx - 3) * 1px; y: (tour.ty - 3) * 1px; width: (tour.tw + 6) * 1px; height: (tour.th + 6) * 1px; border-radius: tour.header-step ? 10px : 16px; border-width: 3px; border-color: UiColors.accent.with-alpha(0.22); }
  // The welcome card, centred, over the open book.
  if tour.step == 0 : Rectangle {
   private property <length> w: min(420px, root.width - 32px);
   x: (root.width - self.w) / 2; y: (root.height - self.height) / 2 + 14px; width: self.w; height: welcome.preferred-height;
   border-radius: 18px; border-width: 1px; border-color: UiColors.edge; background: UiColors.surface;
   drop-shadow-blur: 30px; drop-shadow-offset-y: 10px; drop-shadow-color: #00000045;
   TouchArea { }
   welcome := VerticalLayout { padding: 26px; padding-top: 22px; spacing: 12px;
    HorizontalLayout { alignment: center; Image { width: 72px; height: 72px; source: @image-url("../assets/app.png"); } }
    Text { text: root.arabic ? "قارئ المصحف" : "Quran Mushaf Reader"; color: UiColors.ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
    Text { text: root.arabic ? "مصحف تقلّب صفحاته كالورق، والتفسير والتلاوة على بُعد نقرة." : "A Mushaf that turns like paper, with tafsir and recitation one click away."; color: UiColors.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
    // English on the left, Arabic on the right, whatever the language; the
    // selection slides between them.
    HorizontalLayout { alignment: center; padding-top: 4px;
     Rectangle { width: 220px; height: 36px; border-radius: 9px; background: UiColors.field; border-width: 1px; border-color: UiColors.edge;
      Rectangle { x: root.arabic ? parent.width / 2 : 3px; y: 3px; width: parent.width / 2 - 3px; height: parent.height - 6px; border-radius: 7px; background: UiColors.surface; border-width: 1px; border-color: UiColors.edge;
       animate x { duration: 200ms; easing: ease-in-out; enabled: root.motion-enabled; }
      }
      for language[l] in ["English", "العربية"] : Rectangle { x: l * parent.width / 2; width: parent.width / 2; height: parent.height;
       Text { width: parent.width; height: parent.height; text: language; color: (l == 1) == root.arabic ? UiColors.ink : UiColors.muted; font-size: 13px; font-weight: (l == 1) == root.arabic ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
       TouchArea { clicked => { root.arabic = l == 1; tour-keys.focus(); } }
      }
     }
    }
    VerticalLayout { spacing: 6px; padding-top: 6px;
     Action { height: 40px; primary: true; text: root.arabic ? "خذني في جولة سريعة" : "Show me around"; clicked => { tour.next(); } }
     Action { height: 34px; quiet: true; text: root.arabic ? "ابدأ القراءة مباشرة" : "Start reading"; clicked => { tour.finish(); } }
    }
   }
  }
  // The step card: next to the page corner or the menu, or under a title bar button.
  if tour.step > 0 && root.panel == "" : Rectangle {
   private property <length> w: min(300px, root.width - 32px);
   width: self.w; height: card-column.preferred-height;
   x: !tour.marked ? (root.width - self.w) / 2
      : tour.step == 1 || tour.step == 2 ? (tour.tx + tour.tw + 18 + self.w / 1px < root.width / 1px - 16 ? (tour.tx + tour.tw + 18) * 1px : max(16px, (tour.tx - 18) * 1px - self.w))
      : clamp((tour.tx + tour.tw / 2) * 1px - self.w / 2, 16px, root.width - self.w - 16px);
   y: !tour.marked ? (root.height - self.height) / 2
      : tour.step == 1 ? clamp((tour.ty + tour.th) * 1px - self.height, 16px, root.height - self.height - 16px)
      : tour.step == 2 ? clamp(tour.ty * 1px, 16px, root.height - self.height - 16px)
      : (tour.ty + tour.th + 14) * 1px;
   border-radius: 14px; border-width: 1px; border-color: UiColors.accent.with-alpha(0.55); background: UiColors.surface;
   drop-shadow-blur: 22px; drop-shadow-offset-y: 6px; drop-shadow-color: #00000040;
   TouchArea { }
   card-column := VerticalLayout { padding: 16px; padding-top: 12px; spacing: 6px;
    HorizontalLayout { height: 26px;
     Text { layout-order: root.arabic ? 1 : 0; horizontal-stretch: 1; vertical-alignment: center; color: UiColors.ink; font-size: 15px; font-weight: 700; horizontal-alignment: root.arabic ? right : left;
      text: tour.step == 1 ? (tour.turned ? (root.arabic ? "أحسنت!" : "Nicely done!") : (root.arabic ? "قلّب الصفحة" : "Turn the page"))
       : tour.step == 2 ? (root.arabic ? "قائمة كل آية" : "Every ayah has a menu")
       : tour.step == 3 ? (root.arabic ? "البحث" : "Search")
       : tour.step == 4 ? (root.arabic ? "الاستماع" : "Listen")
       : (root.arabic ? "اجعله لك" : "Make it yours"); }
     Action { layout-order: root.arabic ? 0 : 1; width: 26px; min-height: 26px; max-height: 26px; quiet: true; symbol: 12; text: root.arabic ? "إنهاء الجولة" : "End the tour"; clicked => { tour.finish(); } }
    }
    Text { color: UiColors.muted; font-size: 13px; wrap: word-wrap; horizontal-alignment: root.arabic ? right : left;
     text: tour.step == 1 ? (tour.turned ? (root.arabic ? "ويمكنك أيضًا استخدام أسهم لوحة المفاتيح." : "The arrow keys turn pages too.") : (root.arabic ? "امسك طرف الصفحة واسحبه، كما تفعل بالورق." : "Grab the corner and drag it across, just like paper."))
      : tour.step == 2 ? (root.arabic ? "اضغط بزر الفأرة الأيمن على أي آية: التفسير والتلاوة والعلامات هنا، والسهم يعرض طرقًا أخرى للاستماع." : "Right-click any ayah for its tafsir, recitation and bookmarks. The arrow shows more ways to listen.")
      : tour.step == 3 ? (root.arabic ? "ابحث بكلمات أو بآية مثل 2:255، أو انتقل إلى أي سورة أو صفحة أو جزء. " : "Look up words or an ayah like 2:255, or jump to any surah, page or juz. ") + (root.shortcut-rows.length > 0 ? root.shortcut-rows[0].detail : "")
      : tour.step == 4 ? (root.arabic ? "اختر القارئ، ونزّل السور لتستمع إليها دون اتصال." : "Pick a reciter, and download surahs to listen offline.")
      : (root.arabic ? "المظاهر وخيارات القراءة والاختصارات. ويمكنك إعادة هذه الجولة من هنا." : "Themes, reading options and shortcuts. You can replay this tour from here."); }
    HorizontalLayout { height: 32px; spacing: 8px; padding-top: 4px;
     HorizontalLayout { layout-order: root.arabic ? 3 : 0; alignment: start; spacing: 5px; padding-top: 12px; padding-bottom: 12px;
      for dot[d] in 5 : Rectangle { width: d + 1 == tour.step ? 14px : 6px; height: 6px; border-radius: 3px; background: d + 1 == tour.step ? UiColors.accent : UiColors.edge; }
     }
     Rectangle { layout-order: root.arabic ? 2 : 1; horizontal-stretch: 1; }
     if tour.step > 1 : Action { layout-order: root.arabic ? 1 : 2; width: 70px; quiet: true; text: root.arabic ? "السابق" : "Back"; clicked => { tour.back(); } }
     Action { layout-order: root.arabic ? 0 : 3; width: 84px; primary: true; text: tour.step == tour.steps - 1 ? (root.arabic ? "تم" : "Done") : (root.arabic ? "التالي" : "Next"); clicked => { tour.next(); } }
    }
   }
  }
 }
 // Window resize edges. Each is pinned to its side: without x and y an element is centred.
 Rectangle { x: 0px; y: 0px; width: 4px; height: root.height; TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-edge(0); } } } }
 Rectangle { x: root.width - 4px; y: 0px; width: 4px; height: root.height; TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-edge(1); } } } }
 Rectangle { x: 0px; y: 0px; width: root.width; height: 4px; TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-edge(2); } } } }
 Rectangle { x: 0px; y: root.height - 4px; width: root.width; height: 4px; TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-edge(3); } } } }
}
