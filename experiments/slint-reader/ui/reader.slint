        HorizontalLayout {padding: 4px; spacing: 4px;
         for tab[i] in (root.arabic ? ["السورة", "الصفحة", "الجزء والحزب والربع"] : ["Surah", "Page", "Juz, Hizb & Rub"]) : SearchTab {
