          Text { text: root.arabic ? "اختر قارئًا وسورة بالأسفل لتستمع دون اتصال." : "Choose a reciter and a surah below to listen offline."; color: UiColors.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
