      HorizontalLayout { spacing: 2px;
       HeaderAction { layout-order: root.arabic ? 4 : 0; enabled: root.onboarding-complete; leading-icon: 8; rtl: root.arabic; width: 80px; text: root.arabic ? "بحث" : "Search"; selected: root.panel == "search"; clicked => {root.context-open = false; if root.panel == "search" {root.panel = "";} else {root.open-search();}} }
       HeaderAction { layout-order: root.arabic ? 3 : 1; enabled: root.onboarding-complete; leading-icon: 9; rtl: root.arabic; width: root.audio-active && root.player-docked ? 124px : 80px; quiet: !(root.audio-active && root.player-docked); text: root.audio-active && root.player-docked ? root.audio-title : root.audio-active ? (root.arabic ? "المشغّل" : "Player") : (root.arabic ? "استماع" : "Listen"); hint: root.audio-active ? (root.arabic ? "التلاوة: " : "Recitation: ") + root.audio-title + (root.arabic ? " · فتح المشغّل" : " · Open player") : (root.arabic ? "إعدادات الاستماع والتلاوة" : "Listening and recitation settings"); selected: root.panel == "listen" || (root.audio-active && root.player-docked); clicked => {root.context-open = false; root.player-expanded = true; root.panel = root.panel == "listen" ? "" : "listen";} }
       if root.audio-active && root.player-docked : HeaderAction { layout-order: 2; width: 30px; symbol: root.audio-paused || root.audio-terminal ? 7 : 6; text: root.audio-terminal ? (root.arabic ? "تشغيل مجددًا" : "Play again") : root.audio-paused ? (root.arabic ? "متابعة التلاوة" : "Resume recitation") : (root.arabic ? "إيقاف التلاوة مؤقتًا" : "Pause recitation"); enabled: root.onboarding-complete && !root.audio-loading; selected: !root.audio-paused && !root.audio-terminal; clicked => {root.audio-toggle();} }
       if root.audio-active && root.player-docked : HeaderAction { layout-order: root.arabic ? 1 : 3; enabled: root.onboarding-complete; width: 48px; text: root.arabic ? "إنهاء" : "End"; hint: root.arabic ? "إنهاء التلاوة وإغلاق المشغّل" : "End recitation and close the player"; clicked => {root.audio-end();} }
       HeaderAction { layout-order: root.arabic ? 0 : 4; enabled: root.onboarding-complete; leading-icon: 10; rtl: root.arabic; width: 86px; text: root.arabic ? "الخيارات" : "Options"; selected: root.panel == "settings"; clicked => {root.context-open = false; root.panel = root.panel == "settings" ? "" : "settings";} }
      }
     }
     Rectangle { x: parent.width - 132px; y: 0px; height: parent.height; width: 132px; background: transparent;
      HorizontalLayout {spacing: 0px;
       CaptionButton {kind: 0; label: root.arabic ? "تصغير" : "Minimize"; clicked => {root.window-action(0);} }
       CaptionButton {kind: 1; maximized: root.window-maximized; label: root.arabic ? "تكبير أو استعادة" : "Maximize or restore"; clicked => {root.window-action(1);} }
