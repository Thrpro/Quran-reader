 background: UiColors.canvas;
 init => { UiColors.theme = root.theme; UiColors.old-theme = root.theme; root.presented-theme = root.theme; Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
 changed dark => {
  if root.dark { if root.theme == 1 || root.theme == 2 { root.theme = 0; } } else if root.theme == 0 || root.theme == 3 || root.theme == 4 { root.theme = 1; }
  Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
  root.render-requested(root.canvas-w, root.canvas-h);
 }
 changed theme => { root.dark = root.theme == 0 || root.theme == 3 || root.theme == 4; Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; root.preferences-changed(); root.render-requested(root.canvas-w, root.canvas-h); }
 changed arabic => { root.searched-query = "\u{1}"; root.context-open = false; root.preferences-changed(); root.render-requested(root.canvas-w, root.canvas-h); }
 changed render-generation => { root.context-open = false; }
 changed context-open => { if root.context-open { root.hover-left(); } else { root.listen-more = false; } }
 changed study-body => { if root.study-body != "" && root.panel == "" { root.panel = "study"; } }
 forward-focus: reader-keys;
 reader-keys := FocusScope {
  x: 0px; y: 0px; width: root.width; height: root.height;
  preferred-width: 740px; preferred-height: 500px;
  key-pressed(event) => {
   if event.text == Key.Escape { if root.context-open || root.panel != "" { root.dismiss-overlays(); return accept; } if root.fullscreen { root.fullscreen-requested(); return accept; } }
   if !root.context-open {
    if event.text == Key.LeftArrow && root.panel == "" { root.navigate-key(1, event.repeat); return accept; }
    if event.text == Key.RightArrow && root.panel == "" { root.navigate-key(-1, event.repeat); return accept; }
    if !root.render-busy && root.panel == "study" {
     if event.text == Key.LeftArrow { root.study-step(1); return accept; }
     if event.text == Key.RightArrow { root.study-step(-1); return accept; }
    }
   }
   return reject;
  }
  key-released(event) => {
   if event.text == Key.LeftArrow || event.text == Key.RightArrow { root.navigate-key-released(); }
   return reject;
  }
  VerticalLayout {
   padding: 0px; spacing: 0px;
   if !root.fullscreen : Rectangle {
    height: 28px; background: UiColors.canvas;
    Rectangle { background: transparent; TouchArea { pointer-event(e) => {if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {root.window-action(3);}} double-clicked => {root.window-action(1);} }
     brand := Rectangle { x: 8px; y: 0px; height: parent.height; width: root.arabic ? 112px : 166px; background: transparent;
      init => {root.brand-x = self.x / 1px; root.brand-w = self.width / 1px;}
      changed x => {root.brand-x = self.x / 1px;} changed width => {root.brand-w = self.width / 1px;}
      Path { x: 1px; y: 7px; width: 15px; height: 14px; commands: "M 7.5 2 C 5 0 2 0 0.5 1 L 0.5 12 C 3 11 5.5 11 7.5 13 C 9.5 11 12 11 14.5 12 L 14.5 1 C 12 0 10 0 7.5 2 Z M 7.5 2 L 7.5 13"; fill: transparent; stroke: UiColors.accent; stroke-width: 1.1px; }
      Text { x: 23px; y: 0px; width: parent.width - 26px; height: parent.height; text: root.arabic ? "قارئ المصحف" : "Quran Mushaf Reader"; color: UiColors.ink; font-size: 12px; vertical-alignment: center; horizontal-alignment: root.arabic ? right : left; overflow: elide; }
      TouchArea { pointer-event(e) => {if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {root.window-action(3);}} double-clicked => {root.window-action(1);} }
     }
     navigation := Rectangle { animate x {duration: 160ms; easing: ease-out; enabled: root.motion-enabled && root.onboarding-complete;} x: root.arabic ? parent.width - 136px - self.width : brand.x + brand.width + 4px; y: 0px; height: parent.height; width: root.audio-active && root.player-docked ? 376px : 250px; background: transparent;
      init => {root.nav-x = self.x / 1px; root.nav-w = self.width / 1px;}
      changed x => {root.nav-x = self.x / 1px;} changed width => {root.nav-w = self.width / 1px;}
      HorizontalLayout { spacing: 2px;
       HeaderAction { layout-order: root.arabic ? 4 : 0; leading-icon: 8; rtl: root.arabic; width: 80px; text: root.arabic ? "بحث" : "Search"; selected: root.panel == "search"; clicked => {root.context-open = false; if root.panel == "search" {root.panel = "";} else {root.open-search();}} }
       HeaderAction { layout-order: root.arabic ? 3 : 1; leading-icon: 9; rtl: root.arabic; width: root.audio-active && root.player-docked ? 124px : 80px; quiet: !(root.audio-active && root.player-docked); text: root.audio-active && root.player-docked ? root.audio-title : root.audio-active ? (root.arabic ? "المشغّل" : "Player") : (root.arabic ? "استماع" : "Listen"); hint: root.audio-active ? (root.arabic ? "التلاوة: " : "Recitation: ") + root.audio-title + (root.arabic ? " · فتح المشغّل" : " · Open player") : (root.arabic ? "إعدادات الاستماع والتلاوة" : "Listening and recitation settings"); selected: root.panel == "listen" || (root.audio-active && root.player-docked); clicked => {root.context-open = false; root.player-expanded = true; root.panel = root.panel == "listen" ? "" : "listen";} }
       if root.audio-active && root.player-docked : HeaderAction { layout-order: 2; width: 30px; symbol: root.audio-paused || root.audio-terminal ? 7 : 6; text: root.audio-terminal ? (root.arabic ? "تشغيل مجددًا" : "Play again") : root.audio-paused ? (root.arabic ? "متابعة التلاوة" : "Resume recitation") : (root.arabic ? "إيقاف التلاوة مؤقتًا" : "Pause recitation"); enabled: !root.audio-loading; selected: !root.audio-paused && !root.audio-terminal; clicked => {root.audio-toggle();} }
       if root.audio-active && root.player-docked : HeaderAction { layout-order: root.arabic ? 1 : 3; width: 48px; text: root.arabic ? "إنهاء" : "End"; hint: root.arabic ? "إنهاء التلاوة وإغلاق المشغّل" : "End recitation and close the player"; clicked => {root.audio-end();} }
       HeaderAction { layout-order: root.arabic ? 0 : 4; leading-icon: 10; rtl: root.arabic; width: 86px; text: root.arabic ? "الخيارات" : "Options"; selected: root.panel == "settings"; clicked => {root.context-open = false; root.panel = root.panel == "settings" ? "" : "settings";} }
      }
     }
     Rectangle { x: parent.width - 132px; y: 0px; height: parent.height; width: 132px; background: transparent;
      HorizontalLayout {spacing: 0px;
       CaptionButton {kind: 0; label: root.arabic ? "تصغير" : "Minimize"; clicked => {root.window-action(0);} }
       CaptionButton {kind: 1; maximized: root.window-maximized; label: root.arabic ? "تكبير أو استعادة" : "Maximize or restore"; clicked => {root.window-action(1);} }
       CaptionButton {kind: 2; label: root.arabic ? "إغلاق" : "Close"; clicked => {root.window-action(2);} }
      }
     }
    }
   }
   if !root.fullscreen : Rectangle { height: 1px; background: UiColors.edge; }
   canvas := Rectangle {
    background: UiColors.canvas; vertical-stretch: 1; clip: true;
    changed width => { root.render-requested(self.width / 1px, self.height / 1px); }
    changed height => { root.render-requested(self.width / 1px, self.height / 1px); }
    book-layer := Rectangle {
     x: root.slide-dx * 1px; y: root.slide-dy * 1px; width: canvas.width; height: canvas.height;
     transform-origin: {x: 0px, y: 0px}; transform-scale: root.slide-s;
     // Page edges as in the WebView reader: copies of the page shifted outward
     // by 3, 6 and 8 px at the sides and 3 and 6 px below, each a step closer to
     // the edge colour, so a few pages show behind the open book. Each copy is
     // drawn as a ring, painting only the band that can show around the page.
     if root.book-w > 0 : Rectangle {
      x: (root.raster-canvas-x + root.image-x + root.book-x) * 1px; y: (root.image-y + root.book-y) * 1px;
      width: root.book-w * 1px; height: root.book-h * 1px;
      for sheet in [
       { side: 0, below: 6, tone: 0.66 },
       { side: 0, below: 3, tone: 0.82 },
       { side: 8, below: 0, tone: 0.58 },
       { side: 6, below: 0, tone: 0.72 },
       { side: 3, below: 0, tone: 0.86 },
      ] : Rectangle {
       // Side sheets start a little lower, as page edges under the top page do,
       // so their rounded corners step down instead of bunching at the corner.
       x: -sheet.side * 1px; y: (sheet.below + sheet.side * 0.6) * 1px;
       width: parent.width + sheet.side * 2px; height: parent.height - sheet.side * 0.6px;
       border-radius: 12px;
       border-width: (sheet.side + sheet.below + 6) * 1px;
       border-color: UiColors.surface.mix(UiColors.edge, sheet.tone);
      }
     }
     // Page rasters are transparent outside the rounded paper frame (see
     // clear_outside_frame), so the sheets show through without a per-frame clip.
     Rectangle {
      x: (root.raster-canvas-x + root.image-x + (root.book-w > 0 ? root.book-x : 0)) * 1px;
      y: (root.image-y + (root.book-w > 0 ? root.book-y : 0)) * 1px;
      width: (root.book-w > 0 ? root.book-w : root.image-w) * 1px;
      height: (root.book-w > 0 ? root.book-h : root.image-h) * 1px;
      Rectangle {
       x: -(root.book-w > 0 ? root.book-x : 0) * 1px; y: -(root.book-w > 0 ? root.book-y : 0) * 1px;
       width: root.image-w * 1px; height: root.image-h * 1px;
       Image {
        x: 0px; y: 0px; width: root.image-w * 1px; height: root.image-h * 1px;
        source: root.book-image; image-fit: fill; opacity: root.book-opacity;
        animate opacity { duration: 100ms; enabled: root.motion-enabled; }
        accessible-label: root.arabic ? "صفحات المصحف؛ اختر آية أو اضغط بالزر الأيمن لخياراتها" : "Mushaf pages; select a verse or right-click for its actions";
       }
       if !root.turn-running && root.turn-blend > 0 && root.previous-book.width > 0 : Image {
        x: 0px; y: 0px; width: root.image-w * 1px; height: root.image-h * 1px;
        source: root.previous-book; image-fit: fill; opacity: root.turn-blend;
       }
       if root.turn-running && root.previous-book.width > 0 : Rectangle {
        x: 0px; y: 0px;
        width: root.image-w * 1px; height: root.image-h * 1px; clip: true;
        // Leave the settled original texture untouched. Paint the destination
        // only on the lifted side of the crease, within the turning leaf.
        if root.turn-progress > 0.002 : Rectangle {
         x: root.turn-single || root.turn-direction > 0 ? 0px : root.image-w / 2 * 1px;
         width: root.turn-single ? root.image-w * 1px : root.image-w / 2 * 1px; height: parent.height;
         clip: true;
         FoldClip {
          plane-x: root.fold-plane-x - parent.x / 1px; plane-y: root.fold-plane-y; plane-angle: (root.fold-plane-angle + 180) * 1deg;
          extent: max(root.image-w,root.image-h) * 4px;
          // Absolute texture coordinates: implicit centering in the oversized
          // clipping container leaves the revealed part showing the old page.
          Image { y: 0px; x: root.turn-single || root.turn-direction > 0 ? 0px : -root.image-w / 2 * 1px; width: root.image-w * 1px; height: root.image-h * 1px; source: root.next-book; image-fit: fill; }
         }
         // The lifted leaf shades the page it is revealing, fading away from the crease.
         if root.fold-shading : Rectangle {
          x: root.book-x * 1px - parent.x; y: root.book-y * 1px;
          width: root.book-w * 1px; height: root.book-h * 1px;
          // A plain rectangle clip: a rounded one costs a mask on every frame.
          clip: true;
          Rectangle {
           private property <angle> angle: root.fold-plane-angle * 1deg;
           width: (root.image-w + root.image-h) * 1.5px; height: 32px;
           x: (root.fold-plane-x - root.book-x) * 1px - Math.cos(self.angle) * self.width / 2 + Math.sin(self.angle) * self.height;
           y: (root.fold-plane-y - root.book-y) * 1px - Math.sin(self.angle) * self.width / 2 - Math.cos(self.angle) * self.height;
           transform-origin: {x:0px,y:0px}; transform-rotation: self.angle;
           background: @linear-gradient(0deg, #000000, transparent); opacity: Math.sin(root.turn-progress * 180deg) * 0.24;
          }
         }
        }
        FoldClip {
         plane-x: root.fold-plane-x; plane-y: root.fold-plane-y; plane-angle: root.fold-plane-angle * 1deg;
         extent: max(root.image-w,root.image-h) * 4px;
         Rectangle {
          x: root.fold-back-x * 1px; y: root.fold-back-y * 1px;
          width: root.turn-single ? root.image-w * 1px : root.image-w / 2 * 1px; height: root.image-h * 1px;
          transform-origin: {x:0px,y:0px}; transform-rotation: root.fold-back-angle * 1deg;
          clip: true;
          Image { y: 0px; x: !root.turn-single && root.turn-direction > 0 ? -root.image-w / 2 * 1px : 0px; width: root.image-w * 1px; height: parent.height; source: root.next-book; image-fit: fill; }
          // Soft light across the back of the sheet, so it reads as curved paper.
          if root.fold-shading && root.turn-direction > 0 : Rectangle { background: @linear-gradient(270deg, #00000014 0%, transparent 30%, #ffffff0d 100%); }
          if root.fold-shading && root.turn-direction <= 0 : Rectangle { background: @linear-gradient(90deg, #00000014 0%, transparent 30%, #ffffff0d 100%); }
         }
        }
        // Preparation never replaces a visible face before the corner moves.
        if root.turn-progress <= 0.002 : Image { width: parent.width; height: parent.height; source: root.previous-book; image-fit: fill; }
       }
      }
     }
     if root.book-w > 0 && !root.turn-running : Rectangle {
      x: (root.raster-canvas-x + root.image-x + root.book-x + 6) * 1px; y: (root.image-y + root.book-y + 6) * 1px;
      width: (root.book-w - 12) * 1px; height: (root.book-h - 12) * 1px;
      border-radius: 8px; border-width: 1px; border-color: UiColors.edge.with-alpha(0.45);
     }
     if !root.context-open && !root.render-busy && root.hover-rects.length > 0 : Rectangle {
      background: transparent;
      for patch in root.hover-patches : Image {
       x: (root.raster-canvas-x + root.image-x + patch.x) * 1px; y: (root.image-y + patch.y) * 1px;
       width: patch.w * 1px; height: patch.h * 1px; source: patch.image; image-fit: fill;
      }
     }
    }
    // When the glide has landed: finish at once if the current raster already
    // fits, otherwise ask for the sharp redraw and finish when it arrives.
    Timer {
     interval: 30ms; running: root.book-sliding && !root.slide-awaiting;
     triggered => {
      if root.slide-raw >= 1 {
       if root.slide-settling || root.raster-at-target() { root.book-sliding = false; root.slide-settling = false; }
       else { root.slide-awaiting = true; root.render-requested(root.canvas-w, root.canvas-h); }
      }
     }
    }
    TouchArea {
     x: root.canvas-x * 1px; width: root.canvas-w * 1px;
     enabled: !root.book-sliding && (root.drag-active || !root.render-busy);
     private property <length> drag-start-x;
     private property <int> drag-direction: 1;
     private property <bool> edge-click: false;
     changed has-hover => { if root.pointer-hover-enabled && !self.has-hover && !root.drag-active { root.hover-left(); } }
     clicked => { if self.edge-click { self.edge-click = false; } else if root.context-open { root.context-open = false; } else { reader-keys.focus(); if root.open-tafsir-on-click { root.pick-ayah(self.mouse-x / 1px, self.mouse-y / 1px); } } }
     pointer-event(event) => {
      if event.kind == PointerEventKind.move {
       if root.drag-active && self.pressed { root.drag-progress = (((self.mouse-x - self.drag-start-x) / 1px) * self.drag-direction / max(1, root.image-w * (root.turn-single ? 2 : 1))).clamp(0, 1); }
       else if root.pointer-hover-enabled { root.hover-moved(self.mouse-x / 1px, self.mouse-y / 1px); }
      }
      if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
       self.edge-click = false;
       if !root.context-open && self.mouse-x / 1px >= root.image-x && self.mouse-x / 1px <= root.image-x + root.image-w && self.mouse-y / 1px >= root.image-y && self.mouse-y / 1px <= root.image-y + root.image-h {
        // Page edges, and a generous area around each outer corner of the book.
        if self.mouse-x / 1px < root.image-x + 28 || self.mouse-x / 1px > root.image-x + root.image-w - 28 || self.mouse-y / 1px < root.image-y + 24 || self.mouse-y / 1px > root.image-y + root.image-h - 24
           || ((self.mouse-x / 1px < root.image-x + root.book-x + 110 || self.mouse-x / 1px > root.image-x + root.book-x + root.book-w - 110)
               && (self.mouse-y / 1px < root.image-y + root.book-y + 130 || self.mouse-y / 1px > root.image-y + root.book-y + root.book-h - 130)) {
         self.edge-click = true; self.drag-start-x = self.mouse-x;
         self.drag-direction = self.mouse-x / 1px < root.image-x + root.image-w / 2 ? 1 : -1;
         root.turn-top = self.mouse-y / 1px < root.image-y + root.image-h / 2;
         reader-keys.focus(); root.begin-page-drag(self.drag-direction);
        }
       }
      }
      if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-active { root.end-page-drag(root.drag-progress >= 0.2 || abs(self.mouse-x - self.drag-start-x) < 4px); }
      if event.kind == PointerEventKind.cancel && root.drag-active { root.end-page-drag(false); }
