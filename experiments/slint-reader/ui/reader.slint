    if root.render-busy && root.render-generation == 0 : Text { text: root.arabic ? "جارٍ إعداد الصفحات…" : "Preparing pages…"; color: UiColors.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    HorizontalLayout { x: root.canvas-x * 1px + 8px; y: canvas.height / 2 - 18px; width: root.canvas-w * 1px - 16px; height: 36px;
     Action { visible: root.panel != "study" && !root.study-closing; width: 32px; symbol: 3; text: "‹"; quiet: true; hint: root.arabic ? "الصفحة التالية" : "Next page"; clicked => { root.navigate(1); reader-keys.focus(); } }
     Rectangle { horizontal-stretch: 1; background: transparent; }
     Action { visible: root.panel != "study" && !root.study-closing; width: 32px; symbol: 4; text: "›"; quiet: true; hint: root.arabic ? "الصفحة السابقة" : "Previous page"; clicked => { root.navigate(-1); reader-keys.focus(); } }
    }
    side := Rectangle {
     visible: root.panel != "" || self.opacity > 0.01;
     width: root.panel-kind == "search" ? min(620px, canvas.width - 40px) : root.panel-kind == "study" ? min(344px, canvas.width * 0.4 - 20px) : min(344px, canvas.width - 24px);
     height: root.panel-kind == "search" ? min(root.search-query == "" && root.browse-tab != 0 ? 340px : 560px, canvas.height - 36px) : canvas.height - 20px;
     animate height { duration: 140ms; easing: ease-out; enabled: root.motion-enabled && root.panel == "search" && self.reveal > 0.99; }
