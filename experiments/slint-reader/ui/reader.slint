       Text { layout-order: root.arabic ? 2 : 0; horizontal-stretch: 1; text: root.panel-kind == "search" ? (root.arabic ? "البحث في القرآن" : "Search the Quran") : root.panel-kind == "study" ? (root.arabic ? "تفسير الآية" : "Read Tafsir") : root.panel-kind == "bookmarks" ? (root.arabic ? "العلامات المحفوظة" : "Saved bookmarks") : root.panel-kind == "listen" ? (root.arabic ? "الاستماع" : "Listening") : root.panel-kind == "downloads" ? (root.arabic ? "إدارة التنزيلات" : "Download manager") : root.panel-kind == "shortcuts" ? (root.arabic ? "اختصارات لوحة المفاتيح" : "Keyboard shortcuts") : (root.arabic ? "الخيارات" : "Options"); color: UiColors.ink; font-size: root.panel-kind == "search" ? 18px : 16px; font-weight: 600; horizontal-alignment: root.arabic ? right : left; vertical-alignment: center; }
       if root.fullscreen && root.audio-active && root.player-docked && (root.panel-kind == "search" || root.panel-kind == "settings") : Action { layout-order: 1; width: 36px; symbol: root.audio-paused || root.audio-terminal ? 7 : 6; quiet: true; enabled: !root.audio-loading; text: root.audio-terminal ? (root.arabic ? "تشغيل مجددًا" : "Play again") : root.audio-paused ? (root.arabic ? "متابعة التلاوة" : "Resume recitation") : (root.arabic ? "إيقاف مؤقت" : "Pause recitation"); clicked => { root.audio-toggle(); } }
       Action { layout-order: root.arabic ? 0 : 2; width: 28px; min-height: 28px; max-height: 28px; quiet: true; symbol: 12; text: root.arabic ? "إغلاق" : "Close"; clicked => { root.dismiss-overlays(); } }
      }
      if root.panel-kind == "search" : VerticalLayout {
       spacing: 10px;
       // The field draws its own quiet border: the standard focus underline is clipped away.
       Rectangle { preferred-height: 44px; min-height: 44px; max-height: 44px; border-radius: 8px; clip: true; background: UiColors.field;
        search-field := LineEdit { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 4px; text <=> root.search-query; placeholder-text: ""; horizontal-alignment: root.arabic ? right : left; accessible-label: root.arabic ? "البحث في المصحف" : "Search the Mushaf";
