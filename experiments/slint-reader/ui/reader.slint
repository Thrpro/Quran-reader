 in-out property <int> search-mode: 0; in property <bool> search-busy: false; in property <string> search-status; callback search-mode-changed(int);
 callback focus-reading(); focus-reading => { reader-keys.focus(); }
 callback dismiss-overlays(); dismiss-overlays => { root.context-open = false; if root.panel == "study" { root.close-study(); } root.panel = ""; reader-keys.focus(); }
 out property <float> titlebar-height: 28;
